---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPostSlug } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCoverUrl } from "@/utils/getCoverUrl";
import { slugifyStr } from "@/utils/slugify";
import {
  toTransitionName,
  toCoverTransitionName,
} from "@/utils/toTransitionName";
import EditPost from "./_components/EditPost.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import Toc from "./_components/Toc.astro";
import ReadingSettings from "./_components/ReadingSettings.astro";
import { useTranslations } from "@/i18n";
import { countWords, estimateReadingMinutes } from "@/utils/getReadingTime";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      // sortedPosts is newest-first, so "older" (prev) is a higher index
      // and "newer" (next) is a lower index.
      prevPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
      nextPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const focusCopy =
  locale === "zh"
    ? {
        label: "专注阅读",
        exit: "退出专注模式",
        toc: "打开目录",
        progress: "阅读进度",
      }
    : {
        label: "Focus reading",
        exit: "Exit focus mode",
        toc: "Open table of contents",
        progress: "Reading progress",
      };

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  cover,
} = post.data;

const coverUrl = getCoverUrl(cover);

const { Content, headings } = await render(post);

const totalMin = estimateReadingMinutes(post.body);
const wordCount = countWords(post.body);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <BackButton />

  <main
    id="main-content"
    class:list={[
      "app-layout post-reading-page",
      { "mt-8": !config.features.showBackButton },
    ]}
    data-reading-page
    data-pagefind-body
  >
    <header class="post-reading-header">
      <p class="post-reading-kicker">ARTICLE / KNOWLEDGE BASE</p>
      <h1
        style={{ viewTransitionName: toTransitionName(post.id) }}
        class="post-reading-title"
      >
        {title}
      </h1>

      <div class="post-reading-meta">
        <span class="post-reading-meta-item">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
          </svg>
          <span>{author}</span>
        </span>
        <Datetime
          {pubDatetime}
          {modDatetime}
          {timezone}
          size="lg"
          class="post-reading-meta-item"
        />
        <span class="post-reading-meta-item">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span>{t.post.readingTime.replace("{{min}}", String(totalMin))}</span>
        </span>
        <span class="post-reading-meta-item">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5h14v14H5z"></path>
            <path d="M8 9h8M8 12h8M8 15h5"></path>
          </svg>
          <span>{wordCount.toLocaleString(locale)} {t.post.wordCount}</span>
        </span>
        <span
          aria-hidden="true"
          class:list={[
            "post-reading-meta-separator max-sm:hidden",
            { hidden: !config.features.editPost?.enabled || hideEditPost },
          ]}
        >
          /
        </span>
        <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      </div>
    </header>

    <div
      class="focus-mode-panel"
      data-focus-panel
      aria-hidden="true"
      inert
      aria-label={focusCopy.label}
    >
      <button
        type="button"
        class="focus-mode-action focus-mode-exit"
        data-action="toggle-focus"
        aria-pressed="true"
        aria-label={focusCopy.exit}
        title={focusCopy.exit}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span class="sr-only">{focusCopy.exit}</span>
      </button>

      <div class="focus-mode-context">
        <span class="focus-mode-label">{focusCopy.label}</span>
        <span class="focus-mode-current" data-focus-current>
          {headings[0]?.text}
        </span>
      </div>

      <div class="focus-mode-actions">
        <span
          class="focus-mode-progress"
          data-focus-progress
          aria-label={focusCopy.progress}
        >
          0%
        </span>
        <button
          type="button"
          class="focus-mode-action"
          data-action="toggle-toc"
          aria-controls="toc-desktop toc-mobile"
          aria-expanded="true"
          aria-label={focusCopy.toc}
          title={focusCopy.toc}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 6h14M5 12h14M5 18h14"></path>
            <path d="M3 6h.01M3 12h.01M3 18h.01"></path>
          </svg>
          <span class="sr-only">{focusCopy.toc}</span>
        </button>
      </div>
    </div>

    <!-- Cover hero. Deliberately outside #article: initLightbox only binds
         images inside #article, so this is not a click-to-zoom target. -->
    {
      coverUrl && (
        <div
          style={{ viewTransitionName: toCoverTransitionName(post.id) }}
          class="post-reading-cover"
        >
          {/* decoding=sync + fetchpriority=high: Astro does not wait for images
              before snapshotting the new page, and the list card already fetched
              this exact URL, so a synchronous cache-hot decode is what makes the
              morph snapshot contain pixels instead of an empty box. */}
          <img
            src={coverUrl}
            alt=""
            width="640"
            height="400"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            class="size-full object-cover transition duration-700 hover:scale-[1.02]"
          />
        </div>
      )
    }

    <ReadingSettings />

    <Toc headings={headings} />

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
      data-copy={t.a11y.copyButton}
      data-copied={t.a11y.copiedButton}
      data-zoom={t.a11y.zoomImage}
      data-preview={t.a11y.imagePreview}
      data-close-preview={t.a11y.closeImagePreview}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
</PostLayout>

<style>
  :global(html) {
    --reader-half-width: 22rem;
    --reader-layout-gap: 1rem;
    --reader-toc-width: 12.5rem;
    --reader-rail-width: 4.5rem;
    --reader-settings-width: 4.25rem;
  }

  :global(html[data-reading-width="narrow"]) {
    --reader-half-width: 19rem;
  }

  :global(html[data-reading-width="wide"]) {
    --reader-half-width: min(33.5rem, calc(50vw - 19rem));
  }

  .post-reading-page {
    position: relative;
    margin-top: 2rem !important;
    padding-bottom: 5rem;
    --post-reading-width: 44rem;
  }

  html[data-reading-width="narrow"] .post-reading-page {
    --post-reading-width: 38rem;
  }

  html[data-reading-width="wide"] .post-reading-page {
    --post-reading-width: 48rem;
  }

  .post-reading-header {
    width: 100%;
    max-width: var(--post-reading-width);
    margin-inline: auto;
    padding-block: 1.5rem 2.25rem;
    border-bottom: 1px solid var(--border);
    transition: max-width 320ms var(--ease-out-expo);
  }

  .post-reading-kicker {
    margin-bottom: 0.875rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .post-reading-title {
    display: inline-block;
    max-width: 100%;
    color: var(--foreground);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .post-reading-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
    color: var(--muted-foreground);
  }

  .post-reading-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  .post-reading-meta-item svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .post-reading-meta-item :global(.text-sm),
  .post-reading-meta-item :global(.sm\:text-base) {
    font-size: inherit;
  }

  .post-reading-meta-separator {
    opacity: 0.55;
  }

  .focus-mode-panel {
    position: fixed;
    top: 1rem;
    left: 50%;
    z-index: 50;
    display: flex;
    width: min(30rem, calc(100vw - 2rem));
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 0.375rem;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    box-shadow: 0 18px 44px rgb(var(--shadow-color) / 0.1);
    backdrop-filter: blur(18px);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.75rem);
    visibility: hidden;
    transition:
      opacity 220ms ease,
      transform 260ms var(--ease-out-expo),
      visibility 0s linear 260ms;
  }

  html[data-focus-mode="on"] .focus-mode-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
    visibility: visible;
    transition-delay: 0s;
  }

  .focus-mode-action {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    place-items: center;
    border-radius: 0.75rem;
    color: var(--muted-foreground);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .focus-mode-action:hover,
  .focus-mode-action:focus-visible {
    background: var(--muted);
    color: var(--foreground);
  }

  .focus-mode-action:active {
    transform: scale(0.94);
  }

  .focus-mode-action svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .focus-mode-context {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 0.125rem;
  }

  .focus-mode-label {
    color: var(--muted-foreground);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .focus-mode-current {
    overflow: hidden;
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .focus-mode-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .focus-mode-progress {
    min-width: 2.75rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: end;
  }

  html[data-focus-mode="on"] .post-reading-page {
    padding-top: 4.25rem;
  }

  .post-reading-cover {
    display: block;
    width: 100%;
    max-width: var(--post-reading-width);
    aspect-ratio: 16 / 9;
    margin: 2.5rem auto 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--muted);
    box-shadow: 0 24px 70px rgb(var(--shadow-color) / 0.1);
    transition: max-width 320ms var(--ease-out-expo);
  }

  .post-reading-page :global(#article) {
    width: 100%;
    max-width: var(--post-reading-width);
    transition:
      max-width 320ms var(--ease-out-expo),
      line-height 260ms var(--ease-out-expo);
  }

  @media (min-width: 1024px) and (max-width: 1439px) {
    :global(html) {
      --reader-half-width: 16rem;
      --reader-layout-gap: 0.5rem;
      --reader-toc-width: 10rem;
      --reader-rail-width: 4.25rem;
      --reader-settings-width: 4.25rem;
    }

    :global(html[data-reading-width="narrow"]) {
      --reader-half-width: 15rem;
    }

    :global(html[data-reading-width="wide"]) {
      --reader-half-width: 17rem;
    }

    .post-reading-page {
      --post-reading-width: 32rem;
    }

    html[data-reading-width="narrow"] .post-reading-page {
      --post-reading-width: 30rem;
    }

    html[data-reading-width="wide"] .post-reading-page {
      --post-reading-width: 34rem;
    }
  }

  @media (min-width: 1440px) {
    html[data-reading-width="wide"] .post-reading-page {
      --post-reading-width: min(67rem, calc(100vw - 38rem));
    }

    :global(#site-header),
    :global(#back-button) {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (max-width: 639px) {
    .post-reading-page {
      margin-top: 0.5rem !important;
      padding-bottom: 3rem;
    }

    .post-reading-header {
      padding-top: 0.5rem;
    }

    .post-reading-title {
      font-size: 2.5rem;
    }

    .post-reading-meta-item {
      font-size: 0.8125rem;
    }

    .focus-mode-panel {
      top: 0.625rem;
      width: calc(100vw - 1rem);
      min-height: 3rem;
      gap: 0.5rem;
      border-radius: 0.875rem;
    }

    .focus-mode-action {
      width: 2.25rem;
      height: 2.25rem;
    }

    .focus-mode-current {
      font-size: 0.75rem;
    }

    .focus-mode-progress {
      min-width: 2.5rem;
      font-size: 0.6875rem;
    }

    html[data-focus-mode="on"] .post-reading-page {
      padding-top: 3.75rem;
    }

    .post-reading-cover {
      aspect-ratio: 4 / 3;
      margin-top: 1.75rem;
      border-radius: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-reading-header,
    .post-reading-cover,
    .post-reading-page :global(#article),
    .focus-mode-panel,
    .focus-mode-action {
      transition: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  function initReadingProgress() {
    const progress = document.querySelector("[data-reading-progress]");
    const progressBar = progress?.querySelector("[data-reading-progress-bar]");
    if (!progress || !progressBar || progress.dataset.bound === "true") return;

    progress.dataset.bound = "true";

    const update = () => {
      const maxScroll =
        document.documentElement.scrollHeight - window.innerHeight;
      const scrolled = maxScroll > 0 ? (window.scrollY / maxScroll) * 100 : 0;
      const percentage = Math.min(100, Math.max(0, scrolled));

      progressBar.style.strokeDashoffset = String(100 - percentage);
      progress.querySelector("[data-reading-progress-value]").textContent =
        String(Math.round(percentage));
      progress.setAttribute("aria-valuenow", String(Math.round(percentage)));
      document.querySelectorAll("[data-focus-progress]").forEach(node => {
        node.textContent = `${Math.round(percentage)}%`;
      });
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  initReadingProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const article = document.getElementById("article");
    const copyButtonLabel = article?.dataset.copy ?? "Copy";
    const copiedLabel = article?.dataset.copied ?? "Copied";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      button.innerText = copiedLabel;

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Accessible image lightbox for article images. */
  function initLightbox() {
    const article = document.getElementById("article");
    if (!article) return;

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let overlay = null;
    let lastFocused = null;

    // Defer attribute mutations so they don't push the LCP timestamp.
    // Event listeners below use delegation and don't need the attributes to exist yet.
    requestAnimationFrame(() => {
      const images = Array.from(article.querySelectorAll("img"));
      for (const image of images) {
        if (image.closest("a")) continue;
        image.setAttribute("role", "button");
        image.setAttribute("tabindex", "0");
        image.setAttribute("aria-haspopup", "dialog");
        image.setAttribute(
          "aria-label",
          image.alt
            ? `${article?.dataset.zoom ?? "Zoom image"}: ${image.alt}`
            : (article?.dataset.zoom ?? "Zoom image")
        );
      }
    });

    function open(src, alt, trigger) {
      if (overlay) return;
      lastFocused = trigger ?? document.activeElement;

      overlay = document.createElement("div");
      overlay.setAttribute("role", "dialog");
      overlay.setAttribute("aria-modal", "true");
      overlay.setAttribute(
        "aria-label",
        alt
          ? `${article?.dataset.preview ?? "Image preview"}: ${alt}`
          : (article?.dataset.preview ?? "Image preview")
      );
      overlay.className =
        "fixed inset-0 z-50 flex cursor-zoom-out items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-200 motion-reduce:transition-none";

      const closeButton = document.createElement("button");
      closeButton.type = "button";
      closeButton.setAttribute(
        "aria-label",
        article?.dataset.closePreview ?? "Close image preview"
      );
      closeButton.className =
        "absolute end-4 top-4 rounded p-2 text-3xl leading-none text-white";
      closeButton.innerHTML = "&#10005;";
      closeButton.addEventListener("click", close);

      const image = document.createElement("img");
      image.src = src;
      image.alt = "";
      image.className =
        "max-h-[90dvh] max-w-[90dvw] cursor-default object-contain";

      overlay.append(closeButton, image);
      overlay.addEventListener("click", e => {
        if (e.target === overlay && currentScale <= 1) close();
      });

      let currentScale = 1;
      let translateX = 0;
      let translateY = 0;
      let initialDist = 0;
      let initialScale = 1;
      let panStartX = 0;
      let panStartY = 0;
      let panStartTranslateX = 0;
      let panStartTranslateY = 0;
      let lastTapTime = 0;

      function applyTransform() {
        image.style.transform = `scale(${currentScale}) translate(${translateX}px, ${translateY}px)`;
      }

      function resetTransform() {
        currentScale = 1;
        translateX = 0;
        translateY = 0;
        image.style.transform = "";
      }

      overlay.addEventListener(
        "touchstart",
        e => {
          const t = e.touches;
          if (t.length === 2) {
            initialDist = Math.hypot(
              t[1].clientX - t[0].clientX,
              t[1].clientY - t[0].clientY
            );
            initialScale = currentScale;
          } else if (t.length === 1) {
            const now = Date.now();
            if (now - lastTapTime < 300) {
              e.preventDefault();
              if (currentScale > 1) {
                resetTransform();
              } else {
                currentScale = 2;
                translateX = 0;
                translateY = 0;
                applyTransform();
              }
              lastTapTime = 0;
              panStartX = t[0].clientX;
              panStartY = t[0].clientY;
              panStartTranslateX = translateX;
              panStartTranslateY = translateY;
            } else {
              lastTapTime = now;
              if (currentScale > 1) {
                panStartX = t[0].clientX;
                panStartY = t[0].clientY;
                panStartTranslateX = translateX;
                panStartTranslateY = translateY;
              }
            }
          }
        },
        { passive: false }
      );

      overlay.addEventListener(
        "touchmove",
        e => {
          const t = e.touches;
          if (t.length === 2) {
            e.preventDefault();
            const dist = Math.hypot(
              t[1].clientX - t[0].clientX,
              t[1].clientY - t[0].clientY
            );
            currentScale = Math.min(
              4,
              Math.max(1, initialScale * (dist / initialDist))
            );
            applyTransform();
          } else if (t.length === 1) {
            if (currentScale > 1) {
              e.preventDefault();
              translateX =
                panStartTranslateX + (t[0].clientX - panStartX) / currentScale;
              translateY =
                panStartTranslateY + (t[0].clientY - panStartY) / currentScale;
              const maxX = Math.max(
                0,
                (image.clientWidth - overlay.clientWidth / currentScale) / 2
              );
              const maxY = Math.max(
                0,
                (image.clientHeight - overlay.clientHeight / currentScale) / 2
              );
              translateX = Math.min(maxX, Math.max(-maxX, translateX));
              translateY = Math.min(maxY, Math.max(-maxY, translateY));
              applyTransform();
            } else {
              e.preventDefault();
            }
          }
        },
        { passive: false }
      );

      overlay.addEventListener("touchend", e => {
        if (e.touches.length === 0 && currentScale <= 1.05) {
          resetTransform();
        }
      });

      overlay.addEventListener("touchcancel", e => {
        if (e.touches.length === 0 && currentScale <= 1.05) {
          resetTransform();
        }
      });

      document.body.appendChild(overlay);
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", onKeyDown);
      window.__closeLightbox = close;

      requestAnimationFrame(() => overlay?.classList.add("opacity-100"));
      closeButton.focus();
    }

    function close() {
      if (!overlay) return;
      const el = overlay;
      overlay = null;
      window.__closeLightbox = null;

      document.removeEventListener("keydown", onKeyDown);
      document.body.style.overflow = "";
      lastFocused?.focus();
      lastFocused = null;

      if (prefersReducedMotion()) {
        el.remove();
        return;
      }
      const remove = () => el.remove();
      el.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 250); // fallback in case transitionend never fires
      el.classList.remove("opacity-100");
    }

    function onKeyDown(e) {
      if (e.key === "Escape") {
        close();
      } else if (e.key === "Tab") {
        trapFocus(e);
      }
    }

    // Keep keyboard focus inside the open dialog.
    function trapFocus(e) {
      if (!overlay) return;
      const focusables = overlay.querySelectorAll(
        'a[href], button, [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function triggerFromEvent(e) {
      const image = e.target.closest("img");
      if (!image || !article.contains(image) || image.closest("a")) return null;
      return image;
    }

    function activate(image) {
      open(image.currentSrc || image.src, image.alt, image);
    }

    article.addEventListener("click", e => {
      const image = triggerFromEvent(e);
      if (!image) return;
      e.preventDefault();
      activate(image);
    });

    article.addEventListener("keydown", e => {
      if (e.key !== "Enter" && e.key !== " " && e.key !== "Spacebar") return;
      const image = triggerFromEvent(e);
      if (!image) return;
      e.preventDefault();
      activate(image);
    });
  }
  initLightbox();

  if (!window.__lightboxSwapBound) {
    window.__lightboxSwapBound = true;
    document.addEventListener("astro:before-swap", () =>
      window.__closeLightbox?.()
    );
  }

  // Registered once: this script re-runs on every View Transition, so an
  // unguarded addEventListener would stack a new listener per navigation.
  if (!window.__scrollTopSwapBound) {
    window.__scrollTopSwapBound = true;
    // Routed through the motion module so Lenis, which owns scrolling, resets
    // too — a bare window.scrollTo is a no-op against a Lenis-driven scroll.
    document.addEventListener("astro:after-swap", () =>
      window.__scrollToTop?.()
    );
  }
</script>
