---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<!-- `opacity-0` is the pre-JS state so the button cannot flash before the
     module script runs; the transform is owned by GSAP, deliberately not by a
     Tailwind translate class, which would compound with GSAP's transform. -->
<div
  id="btt-btn-container"
  class:list={[
    "fixed inset-e-4 bottom-8 z-50 opacity-0",
    "md:sticky md:inset-e-auto md:float-end md:me-1",
  ]}
>
  <button
    data-button="back-to-top"
    class:list={[
      "group bg-background relative px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconArrowLeft class="inline-block rotate-90 md:hidden" />
    <span class="group-hover:text-accent sr-only text-sm md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" />
      {t.post.backToTop}
    </span>
  </button>
</div>

<script>
  import { gsap, dur, easeOutExpo, scrollToTop } from "@/scripts/motion";

  const HIDDEN_Y = 56;

  let container: HTMLElement | null = null;
  let indicator: HTMLElement | null = null;
  // null = not yet initialised for the current page.
  let shown: boolean | null = null;

  function bind() {
    container = document.querySelector<HTMLElement>("#btt-btn-container");
    indicator = document.querySelector<HTMLElement>("#progress-indicator");
    const btn = document.querySelector<HTMLElement>(
      "[data-button='back-to-top']"
    );

    if (!container || !indicator || !btn) return;

    // Every page starts at the top, so start hidden and drop any tween still
    // finishing on the element the navigation just replaced.
    gsap.killTweensOf(container);
    gsap.set(container, { opacity: 0, y: HIDDEN_Y });
    shown = false;

    btn.addEventListener("click", () => scrollToTop());
  }

  function handleScroll() {
    const root = document.documentElement;
    const scrollTotal = root.scrollHeight - root.clientHeight;
    if (!container || !indicator || scrollTotal <= 0) return;

    const scrollTop = root.scrollTop;
    const percent = Math.floor((scrollTop / scrollTotal) * 100);

    // A per-frame colour value, not an animation — written directly.
    indicator.style.setProperty(
      "background-image",
      `conic-gradient(var(--accent), var(--accent) ${percent}%, transparent ${percent}%)`
    );

    const isVisible = scrollTop / scrollTotal > 0.3;
    if (isVisible === shown) return;
    shown = isVisible;

    gsap.to(container, {
      opacity: isVisible ? 1 : 0,
      y: isVisible ? 0 : HIDDEN_Y,
      duration: dur(0.5),
      ease: easeOutExpo,
    });
  }

  bind();
  document.addEventListener("astro:after-swap", bind);

  // One scroll listener for the life of the page, now that this is a bundled
  // module script rather than an is:inline one re-run per navigation.
  let ticking = false;
  document.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        handleScroll();
        ticking = false;
      });
    },
    { passive: true }
  );
</script>
