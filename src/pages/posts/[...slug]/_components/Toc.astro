---
import { useTranslations } from "@/i18n";

type Heading = { depth: number; slug: string; text: string };

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;

const locale = Astro.currentLocale;
const t = useTranslations(locale);

// Only track h2/h3 to keep the TOC readable.
const tocItems = headings.filter(h => h.depth === 2 || h.depth === 3);

// Hierarchical numbering: h2 → 1, 2, 3… ; h3 → 2.1, 2.2…
let h2Index = 0;
let h3Index = 0;
const items = tocItems.map(h => {
  if (h.depth === 2) {
    h2Index += 1;
    h3Index = 0;
    return { ...h, num: `${h2Index}`, isSub: false };
  }
  h3Index += 1;
  return { ...h, num: `${h2Index}.${h3Index}`, isSub: true };
});
---

{
  items.length > 0 && (
    <>
      {/* Desktop: sticky side TOC with scroll tracking */}
      <nav
        id="toc-desktop"
        aria-label={t.post.toc}
        class="animate-toc-in fixed top-28 z-30 hidden w-56 xl:block 2xl:w-64"
        style={{ left: "calc(50% + 26rem)" }}
      >
        <p class="text-muted-foreground mb-2 text-xs font-semibold tracking-widest uppercase">
          {t.post.toc}
        </p>
        <ul class="max-h-[65vh] space-y-0.5 overflow-y-auto pe-1">
          {items.map(h => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={["toc-row", { "toc-row-sub": h.isSub }]}
              >
                {h.isSub ? (
                  <span class="toc-dot" aria-hidden="true" />
                ) : (
                  <span class="toc-badge" aria-hidden="true">
                    {h.num}
                  </span>
                )}
                {h.isSub && (
                  <span class="toc-subnum" aria-hidden="true">
                    {h.num}
                  </span>
                )}
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Mobile: collapsible TOC above the article */}
      <details
        id="toc-mobile"
        class="animate-fade-up border-border bg-muted/40 mt-6 mb-6 rounded-lg border xl:hidden"
      >
        <summary class="flex cursor-pointer items-center justify-between px-4 py-2.5 font-medium select-none">
          {t.post.toc}
        </summary>
        <ul class="border-border space-y-0.5 border-t px-3 py-2">
          {items.map(h => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={["toc-row", { "toc-row-sub": h.isSub }]}
              >
                {h.isSub ? (
                  <span class="toc-dot" aria-hidden="true" />
                ) : (
                  <span class="toc-badge" aria-hidden="true">
                    {h.num}
                  </span>
                )}
                {h.isSub && (
                  <span class="toc-subnum" aria-hidden="true">
                    {h.num}
                  </span>
                )}
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </>
  )
}

<style>
  /* Entrance animation (desktop side TOC) */
  @keyframes toc-in {
    from {
      opacity: 0;
      transform: translateX(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .animate-toc-in {
    animation: toc-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-toc-in {
      animation: none;
    }
  }

  .toc-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding-block: 0.375rem;
    padding-inline-start: 1rem;
    padding-inline-end: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted-foreground);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  /* Segmented progress bar: one tick per row */
  .toc-row::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.3125rem;
    bottom: 0.3125rem;
    width: 2px;
    border-radius: 9999px;
    background: var(--border);
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  /* Sections already read: partially lit */
  .toc-row[data-passed]::before {
    background: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  /* Current section: fully lit with a soft glow */
  .toc-row[data-active]::before {
    background: var(--accent);
    box-shadow: 0 0 8px 0 color-mix(in srgb, var(--accent) 45%, transparent);
    transform: scaleY(1.15);
  }

  .toc-row:hover {
    color: var(--foreground);
    background: var(--muted);
  }

  /* Sub-level (h3): indented, bullet + hierarchical number */
  .toc-row-sub {
    padding-inline-start: 1.75rem;
    gap: 0.375rem;
    font-size: 0.78125rem;
  }

  .toc-dot {
    flex: none;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 9999px;
    background: var(--border);
    transition: background-color 0.2s ease;
  }

  .toc-subnum {
    flex: none;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  /* Numbered badge for h2 entries */
  .toc-badge {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .toc-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Active row: highlighted pill + filled badge */
  a[data-active] {
    color: var(--foreground);
    background: var(--muted);
    font-weight: 500;
  }

  a[data-active] .toc-badge {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--background);
    transform: scale(1.08);
  }

  a[data-active] .toc-dot {
    background: var(--accent);
  }

  a[data-active] .toc-subnum {
    color: var(--accent);
    opacity: 1;
  }

  /* Mobile collapsible TOC */
  #toc-mobile summary::-webkit-details-marker {
    display: none;
  }
</style>

<script is:inline data-astro-rerun>
  /** Scrollspy: highlight the TOC entry of the section currently in view. */
  function initTocScrollSpy() {
    const links = Array.from(
      document.querySelectorAll("[data-toc-link]")
    );
    if (links.length === 0) return;

    const headingEls = links
      .map(link => document.getElementById(link.dataset.tocLink))
      .filter(Boolean);

    if (headingEls.length === 0) return;

    let activeId = headingEls[0].id;
    let ticking = false;

    // Segmented progress: mark `id` as active, sections above as passed,
    // then keep the active row visible inside the scrollable TOC list.
    function setActive(id) {
      activeId = id;
      const curIdx = headingEls.findIndex(el => el.id === id);
      for (const link of links) {
        const idx = headingEls.findIndex(el => el.id === link.dataset.tocLink);
        if (idx === curIdx) {
          link.setAttribute("data-active", "");
          link.removeAttribute("data-passed");
        } else if (idx < curIdx) {
          link.removeAttribute("data-active");
          link.setAttribute("data-passed", "");
        } else {
          link.removeAttribute("data-active");
          link.removeAttribute("data-passed");
        }
      }
      // `block: "nearest"` only scrolls the TOC list when the active row is
      // outside it — the fixed nav never triggers page scrolling.
      links
        .find(link => link.dataset.tocLink === id)
        ?.scrollIntoView({ block: "nearest" });
    }

    function update() {
      ticking = false;

      // The section closest to (but above) the reading line wins.
      // 120px matches the anchor landing spot (scroll-padding 6rem +
      // heading scroll-margin 1rem = 112px), so a TOC jump keeps the
      // clicked entry highlighted.
      const readingLine = 120;
      let current = headingEls[0].id;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= readingLine) {
          current = el.id;
        }
      }

      // Snap to the last heading near the bottom of the page.
      if (
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 4
      ) {
        current = headingEls[headingEls.length - 1].id;
      }

      if (current === activeId) return;
      setActive(current);
    }

    // Clicking a TOC entry: highlight it right away (don't wait for the
    // smooth scroll to finish) and collapse the mobile TOC afterwards.
    for (const link of links) {
      link.addEventListener("click", () => {
        setActive(link.dataset.tocLink);
        const details = link.closest("details");
        if (details) details.removeAttribute("open");
      });
    }

    document.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );

    update();
  }

  // This component renders BEFORE the <article> in the DOM, so heading
  // elements don't exist yet when the inline script executes during parse.
  // Wait for the DOM to be ready before wiring up the scrollspy.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTocScrollSpy, {
      once: true,
    });
  } else {
    initTocScrollSpy();
  }
</script>
