---
import config from "@/config";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? config.site.lang;
const zh = locale === "zh";
const homeHref = getRelativeLocaleUrl(locale, "");
const copy = zh
  ? {
      title: "阅读工具",
      back: "返回首页",
      theme: "切换主题",
      share: "复制文章链接",
      toc: "展开目录",
      width: "阅读宽度",
      size: "字号",
      leading: "行距",
      focus: "专注模式",
      progress: "阅读进度",
      narrow: "窄",
      normal: "标准",
      wide: "宽",
      small: "小",
      medium: "中",
      large: "大",
      tight: "紧凑",
      relaxed: "舒适",
      loose: "宽松",
      increase: "增大",
      decrease: "减小",
    }
  : {
      title: "Reading tools",
      back: "Back to home",
      theme: "Toggle theme",
      share: "Copy article link",
      toc: "Expand contents",
      width: "Reading width",
      size: "Type size",
      leading: "Line height",
      focus: "Focus mode",
      progress: "Reading progress",
      narrow: "Narrow",
      normal: "Standard",
      wide: "Wide",
      small: "Small",
      medium: "Medium",
      large: "Large",
      tight: "Tight",
      relaxed: "Comfortable",
      loose: "Loose",
      increase: "Increase",
      decrease: "Decrease",
    };
---

<nav class="reading-left-rail" aria-label={copy.title}>
  <a
    class="reading-tool"
    href={homeHref}
    title={copy.back}
    aria-label={copy.back}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </a>
  <span class="reading-tool-rule" aria-hidden="true"></span>
  <div
    class="reading-progress-tool"
    data-reading-progress
    role="progressbar"
    aria-label={copy.progress}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <svg class="reading-progress-ring" viewBox="0 0 40 40" aria-hidden="true">
      <circle class="reading-progress-track" cx="20" cy="20" r="16"></circle>
      <circle
        class="reading-progress-value"
        data-reading-progress-bar
        cx="20"
        cy="20"
        r="16"></circle>
    </svg>
    <span class="reading-progress-number" data-reading-progress-value>0</span>
  </div>
  <span class="reading-tool-rule" aria-hidden="true"></span>
  <button
    type="button"
    class="reading-tool"
    data-action="toggle-toc"
    aria-controls="toc-desktop"
    aria-expanded="true"
    title={copy.toc}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 6h14M5 12h14M5 18h14"></path>
      <path d="M3 6h.01M3 12h.01M3 18h.01"></path>
    </svg>
    <span class="sr-only">{copy.toc}</span>
  </button>
  <button
    id="focus-mode-toggle-left"
    type="button"
    class="reading-tool"
    data-action="toggle-focus"
    aria-pressed="false"
    title={copy.focus}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"
      ></path>
      <rect x="8" y="8" width="8" height="8" rx="1"></rect>
    </svg>
    <span class="sr-only">{copy.focus}</span>
  </button>
  <button
    type="button"
    class="reading-tool"
    data-action="share"
    title={copy.share}
    aria-label={copy.share}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 16V4"></path>
      <path d="m8 8 4-4 4 4"></path>
      <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path>
    </svg>
    <span class="sr-only">{copy.share}</span>
  </button>
</nav>

<aside id="reading-settings" class="reading-settings" aria-label={copy.title}>
  <div class="reading-toolbar" role="toolbar" aria-label={copy.title}>
    <button
      type="button"
      class="reading-tool"
      data-theme-toggle
      title={copy.theme}
      aria-label={copy.theme}
    >
      <svg
        class="theme-icon theme-icon-light"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
        ></path>
      </svg>
      <svg
        class="theme-icon theme-icon-dark"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M12 3a9 9 0 1 0 9 9c0-.55-.05-1.08-.14-1.6A7.5 7.5 0 0 1 13.6 3.14C13.08 3.05 12.55 3 12 3Z"
        ></path>
      </svg>
      <span class="sr-only">{copy.theme}</span>
    </button>

    <span class="reading-tool-rule" aria-hidden="true"></span>

    <button
      type="button"
      class="reading-tool"
      data-action="cycle-width"
      title={copy.width}
      aria-label={copy.width}
    >
      <svg data-width-icon="narrow" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="7" y="5" width="10" height="14" rx="1.5"></rect>
        <path d="M10 9h4M10 12h4M10 15h3"></path>
      </svg>
      <svg data-width-icon="normal" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="5" y="5" width="14" height="14" rx="1.5"></rect>
        <path d="M8 9h8M8 12h8M8 15h5"></path>
      </svg>
      <svg data-width-icon="wide" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
        <path d="M7 9h10M7 12h10M7 15h6"></path>
      </svg>
      <span class="sr-only">{copy.width}</span>
    </button>

    <div
      class="reading-adjuster"
      data-adjuster="size"
      role="group"
      aria-label={copy.size}
    >
      <span class="reading-glyph" aria-hidden="true">字</span>
      <button
        type="button"
        class="reading-step-button"
        data-step-setting="size"
        data-step="-1"
        aria-label={copy.decrease}
        title={copy.decrease}>−</button
      >
      <output class="reading-step-value" data-setting-display="size"
        >16px</output
      >
      <button
        type="button"
        class="reading-step-button"
        data-step-setting="size"
        data-step="1"
        aria-label={copy.increase}
        title={copy.increase}>+</button
      >
    </div>

    <div
      class="reading-adjuster"
      data-adjuster="leading"
      role="group"
      aria-label={copy.leading}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 6h14M5 12h14M5 18h14"></path>
        <path d="M3 3v18"></path>
      </svg>
      <button
        type="button"
        class="reading-step-button"
        data-step-setting="leading"
        data-step="-1"
        aria-label={copy.decrease}
        title={copy.decrease}>−</button
      >
      <output class="reading-step-value" data-setting-display="leading"
        >1.85</output
      >
      <button
        type="button"
        class="reading-step-button"
        data-step-setting="leading"
        data-step="1"
        aria-label={copy.increase}
        title={copy.increase}>+</button
      >
    </div>
  </div>
</aside>

<style>
  .reading-left-rail {
    position: fixed;
    top: 50%;
    left: max(
      0.75rem,
      calc(
        50% - var(--reader-half-width) - var(--reader-layout-gap) -
          var(--reader-rail-width)
      )
    );
    z-index: 40;
    display: grid;
    width: var(--reader-rail-width);
    gap: 0.25rem;
    padding: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: 0 18px 44px rgb(var(--shadow-color) / 0.1);
    backdrop-filter: blur(18px);
    transform: translateY(-50%);
    transition: left 320ms var(--ease-out-expo);
  }

  .reading-settings {
    position: fixed;
    top: 50%;
    right: max(
      0.75rem,
      calc(
        50% - var(--reader-half-width) - var(--reader-layout-gap) -
          var(--reader-settings-width)
      )
    );
    z-index: 40;
    transform: translateY(-50%);
    transition: right 320ms var(--ease-out-expo);
  }

  .reading-toolbar {
    display: grid;
    width: 4.5rem;
    gap: 0.3rem;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: 0 18px 44px rgb(var(--shadow-color) / 0.1);
    backdrop-filter: blur(18px);
  }

  .reading-tool {
    display: grid;
    min-width: 3.5rem;
    min-height: 3.5rem;
    place-items: center;
    border-radius: 0.875rem;
    color: var(--muted-foreground);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .reading-tool:hover,
  .reading-tool[aria-expanded="true"],
  .reading-tool[aria-pressed="true"],
  .reading-tool[data-copied] {
    background: var(--foreground);
    color: var(--background);
  }

  .reading-tool:active {
    transform: scale(0.94);
  }

  .reading-tool svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .theme-icon,
  [data-width-icon] {
    display: none;
  }

  .theme-icon[data-active],
  [data-width-icon][data-active] {
    display: block;
  }

  .reading-adjuster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1.5rem 2.25rem 2.25rem 2.25rem;
    align-items: center;
    gap: 0.2rem;
    width: 3.5rem;
    min-height: 8.75rem;
    min-width: 3.5rem;
    justify-items: center;
    justify-self: center;
    border: 0;
    border-radius: 1rem;
    padding: 0.5rem 0.2rem;
    background: color-mix(in srgb, var(--muted) 72%, transparent);
    color: var(--muted-foreground);
  }

  .reading-adjuster > svg {
    width: 1rem;
    height: 1rem;
    grid-row: 1;
    justify-self: center;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .reading-glyph {
    display: grid;
    grid-row: 1;
    width: 100%;
    place-items: center;
    color: currentColor;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1;
  }

  .reading-adjuster[data-adjuster="size"] .reading-step-button[data-step="1"],
  .reading-adjuster[data-adjuster="leading"]
    .reading-step-button[data-step="1"] {
    grid-row: 2;
  }

  .reading-adjuster .reading-step-value {
    grid-row: 3;
    display: grid;
    width: 100%;
    place-items: center;
    text-align: center;
  }

  .reading-adjuster[data-adjuster="size"] .reading-step-button[data-step="-1"],
  .reading-adjuster[data-adjuster="leading"]
    .reading-step-button[data-step="-1"] {
    grid-row: 4;
  }

  .reading-progress-tool {
    position: relative;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
  }

  .reading-progress-ring {
    width: 2.75rem;
    height: 2.75rem;
    transform: rotate(-90deg);
  }

  .reading-progress-track {
    fill: none;
    stroke: var(--border);
    stroke-width: 3;
  }

  .reading-progress-value {
    fill: none;
    stroke: var(--foreground);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 220ms var(--ease-out-expo);
  }

  .reading-progress-number {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--foreground);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .reading-tool-rule {
    height: 1px;
    margin: 0.125rem 0.5rem;
    background: var(--border);
  }

  .reading-popover {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    width: 12rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    box-shadow: 0 18px 44px rgb(var(--shadow-color) / 0.12);
    backdrop-filter: blur(18px);
  }

  .reading-popover[hidden] {
    display: none;
  }

  .reading-popover-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reading-option-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .reading-option {
    min-height: 2.25rem;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding-inline: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .reading-option:hover,
  .reading-option[data-selected] {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--background);
  }

  .reading-option:active,
  .reading-step-button:active {
    transform: scale(0.96);
  }

  .reading-stepper {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .reading-step-button {
    display: grid;
    width: 2.25rem;
    min-height: 2.25rem;
    justify-self: center;
    place-items: center;
    border: 0;
    border-radius: 0.625rem;
    color: var(--foreground);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .reading-step-button:hover {
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }

  .reading-step-value {
    overflow: hidden;
    color: var(--foreground);
    font-size: 0.8125rem;
    line-height: 1;
    font-weight: 600;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .reading-left-rail {
      display: none;
    }

    .reading-settings {
      display: none;
    }
  }

  @media (min-width: 1024px) and (max-width: 1439px) {
    .reading-popover {
      top: 50%;
      right: calc(100% + 0.75rem);
      bottom: auto;
      transform: translateY(-50%);
    }
  }

  @media (min-width: 1440px) {
    .reading-popover {
      top: 50%;
      right: calc(100% + 0.75rem);
      bottom: auto;
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-left-rail,
    .reading-settings,
    .reading-tool,
    .reading-option,
    .reading-step-button,
    .reading-progress-value {
      transition: none;
    }
  }
</style>

<script>
  const SETTINGS_KEY = "alice-reading-settings";
  type ReadingWidth = "narrow" | "normal" | "wide";
  type ReadingSettings = {
    width: ReadingWidth;
    size: number;
    leading: number;
    focus: boolean;
  };

  const defaults: ReadingSettings = {
    width: "normal",
    size: 16,
    leading: 1.85,
    focus: false,
  };

  const widthValues: ReadingWidth[] = ["narrow", "normal", "wide"];
  const settingRanges = {
    size: { min: 14, max: 24, step: 1 },
    leading: { min: 1.6, max: 2, step: 0.05 },
  } as const;

  const legacySizeValues: Record<string, number> = {
    small: 15,
    medium: 16,
    large: 18,
  };
  const legacyLeadingValues: Record<string, number> = {
    tight: 1.65,
    relaxed: 1.85,
    loose: 2,
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const roundTo = (value: number, precision: number) =>
    Number(value.toFixed(precision));

  function normalizeSettings(
    value: Partial<ReadingSettings> & Record<string, unknown>
  ) {
    const rawSize = value.size;
    const rawLeading = value.leading;
    const size =
      typeof rawSize === "number"
        ? clamp(
            Math.round(rawSize),
            settingRanges.size.min,
            settingRanges.size.max
          )
        : clamp(
            legacySizeValues[String(rawSize)] ?? defaults.size,
            settingRanges.size.min,
            settingRanges.size.max
          );
    const leading =
      typeof rawLeading === "number"
        ? clamp(
            roundTo(rawLeading, 2),
            settingRanges.leading.min,
            settingRanges.leading.max
          )
        : clamp(
            legacyLeadingValues[String(rawLeading)] ?? defaults.leading,
            settingRanges.leading.min,
            settingRanges.leading.max
          );

    return {
      width: widthValues.includes(value.width as ReadingWidth)
        ? (value.width as ReadingWidth)
        : defaults.width,
      size,
      leading,
      focus: typeof value.focus === "boolean" ? value.focus : defaults.focus,
    } satisfies ReadingSettings;
  }

  function initReadingSettings() {
    const root = document.getElementById("reading-settings");
    const leftRail = document.querySelector<HTMLElement>(".reading-left-rail");
    const themeButton = root?.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]"
    );
    const widthButton = root?.querySelector<HTMLButtonElement>(
      '[data-action="cycle-width"]'
    );
    const compactViewport = window.matchMedia("(max-width: 1023px)");
    const focusToggles = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        '[data-action="toggle-focus"]'
      )
    );
    const focusPanels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-focus-panel]")
    );
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    let settings = { ...defaults };
    try {
      settings = normalizeSettings(
        JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? "{}")
      );
    } catch {
      // Ignore malformed local preferences and keep the defaults.
    }

    const syncThemeIcon = () => {
      const theme =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      themeButton?.querySelectorAll<SVGElement>(".theme-icon").forEach(icon => {
        icon.toggleAttribute(
          "data-active",
          icon.classList.contains(`theme-icon-${theme}`)
        );
      });
      themeButton?.setAttribute(
        "aria-label",
        theme === "dark" ? "切换到白天模式" : "切换到黑夜模式"
      );
      themeButton?.setAttribute(
        "title",
        theme === "dark" ? "白天模式" : "黑夜模式"
      );
    };

    const syncWidthIcon = () => {
      widthButton
        ?.querySelectorAll<SVGElement>("[data-width-icon]")
        .forEach(icon => {
          icon.toggleAttribute(
            "data-active",
            icon.dataset.widthIcon === settings.width
          );
        });
      widthButton?.setAttribute("data-width-state", settings.width);
    };

    const apply = () => {
      const appliedSettings = compactViewport.matches
        ? {
            ...settings,
            width: defaults.width,
            size: defaults.size,
            leading: defaults.leading,
          }
        : settings;

      document.documentElement.dataset.readingWidth =
        appliedSettings.width === "normal" ? "" : appliedSettings.width;
      document.documentElement.style.setProperty(
        "--reading-size-value",
        `${appliedSettings.size}px`
      );
      document.documentElement.style.setProperty(
        "--reading-leading-value",
        String(appliedSettings.leading)
      );
      document.documentElement.dataset.focusMode = settings.focus
        ? "on"
        : "off";
      focusToggles.forEach(toggle =>
        toggle.setAttribute("aria-pressed", String(settings.focus))
      );
      focusPanels.forEach(panel =>
        panel.toggleAttribute("inert", !settings.focus)
      );
      focusPanels.forEach(panel =>
        panel.setAttribute("aria-hidden", String(!settings.focus))
      );
      syncWidthIcon();

      root
        .querySelectorAll<HTMLElement>('[data-setting-display="size"]')
        .forEach(display => {
          display.textContent = `${appliedSettings.size}px`;
        });
      root
        .querySelectorAll<HTMLElement>('[data-setting-display="leading"]')
        .forEach(display => {
          display.textContent = appliedSettings.leading.toFixed(2);
        });

      localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    };

    widthButton?.addEventListener("click", () => {
      const currentIndex = widthValues.indexOf(settings.width);
      settings.width = widthValues[(currentIndex + 1) % widthValues.length];
      apply();
    });

    root
      .querySelectorAll<HTMLElement>("[data-step-setting]")
      .forEach(button => {
        button.addEventListener("click", () => {
          const key = button.dataset.stepSetting as "size" | "leading";
          const range = settingRanges[key];
          const direction = Number(button.dataset.step ?? 0);
          const nextValue = clamp(
            settings[key] + direction * range.step,
            range.min,
            range.max
          );
          settings[key] =
            key === "leading" ? roundTo(nextValue, 2) : Math.round(nextValue);
          apply();
        });
      });

    document.querySelectorAll('[data-action="toggle-toc"]').forEach(button =>
      button.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("reading:toggle-toc"));
      })
    );

    focusToggles.forEach(toggle => {
      toggle.addEventListener("click", () => {
        settings.focus = !settings.focus;
        apply();
      });
    });

    const handleViewportChange = () => apply();
    compactViewport.addEventListener("change", handleViewportChange);

    leftRail
      ?.querySelector('[data-action="share"]')
      ?.addEventListener("click", async event => {
        const button = event.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(window.location.href);
          button.setAttribute("data-copied", "");
          window.setTimeout(() => button.removeAttribute("data-copied"), 900);
        } catch {
          // Clipboard access can be unavailable in non-secure preview contexts.
        }
      });

    const themeObserver = new MutationObserver(syncThemeIcon);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    syncThemeIcon();
    apply();
  }

  initReadingSettings();
  document.addEventListener("astro:after-swap", initReadingSettings);
</script>
