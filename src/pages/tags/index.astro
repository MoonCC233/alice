---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/components/Main.astro";
import TagGraph from "@/components/TagGraph.astro";
import { getTagGraph } from "@/utils/getTagGraph";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts");
const graph = getTagGraph(posts);
const totalPosts = posts.filter(postFilter).length;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`} breadcrumb>
  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <TagGraph {graph} postCount={totalPosts} />
  </Main>
</Layout>
