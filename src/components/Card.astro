---
import type { CollectionEntry } from "astro:content";
import { getCoverUrl } from "@/utils/getCoverUrl";
import { getPostUrl } from "@/utils/getPostPaths";
import {
  toTransitionName,
  toCoverTransitionName,
} from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, cover, ...props } = data;
const coverUrl = getCoverUrl(cover);
---

<!-- The flex row is an inner div, never the <li>: `display: flex` on an <li>
     drops its listitem role in Blink and #post-list would lose its semantics. -->
<li
  class="group border-border relative my-0 border-b py-5 first:pt-0 last:border-b-0"
>
  <div class="flex items-start gap-5">
    {
      coverUrl && (
        <span
          style={{ viewTransitionName: toCoverTransitionName(id) }}
          class="bg-muted border-border block aspect-[16/10] w-28 flex-none overflow-hidden rounded-md border sm:w-40"
        >
          {/* The name is on this wrapper, not the img: ClientRouter does not
              wait for images before snapshotting, so a named <img> can capture
              empty — the wrapper's bg-muted degrades gracefully. It also bakes
              in the crop and radius. */}
          <img
            src={coverUrl}
            alt=""
            width="640"
            height="400"
            loading="lazy"
            class="size-full object-cover transition duration-500 group-hover:scale-[1.04]"
          />
        </span>
      )
    }

    <!-- items-start above is load-bearing: the default align-self:stretch makes
         the thumbnail's height definite, which overrides aspect-ratio and
         deforms the cover whenever the text column is taller than it. -->
    <div class="min-w-0 flex-1">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-foreground inline-block text-lg leading-tight font-semibold",
          "underline-offset-4 group-hover:underline",
          "transition-colors duration-200",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          transition:name={toTransitionName(id)}
          class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
        >
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
      <p
        class="text-muted-foreground mt-2 line-clamp-2 text-[15px] leading-relaxed"
      >
        {description}
      </p>
    </div>
  </div>
</li>
