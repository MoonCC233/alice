---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconHome from "@/assets/icons/IconHome.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import IconLink from "@/assets/icons/IconLink.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconChevronDown from "@/assets/icons/IconChevronDown.svg";
import Logo from "@/assets/icons/Logo.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Locale URL prefix used by the client-side active-link resolver.
// astro.config.ts: routing.prefixDefaultLocale = false and only "zh" exists,
// so the default locale has no URL prefix. When a prefixed secondary locale
// (e.g. "en") is added, this must become `/${locale}` for that locale.
const localePrefix = "";

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isHome = currentPath === "" || currentPath === "/";

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The "content" nav entry groups posts/tags/archives behind one submenu, so it
// counts as active when any of its children is the current page. The
// comma-separated list is the format the client-side resolver already expects.
const groupPaths = [
  "/posts",
  "/tags",
  ...(features.showArchives ? ["/archives"] : []),
];
const groupNavPaths = groupPaths.join(",");
const isGroupActive = groupPaths.some(isActive);

const navItem =
  "nav-item relative z-10 flex items-center gap-1.5 rounded-full px-4 py-2 text-[15px] leading-none font-semibold whitespace-nowrap transition-[color,transform] duration-200 active:scale-[0.93]";
const navIconLink =
  "relative grid size-9 place-items-center rounded-full transition-all duration-200 hover:bg-muted/60 hover:text-foreground active:scale-95 max-sm:size-10";
const island =
  "bg-background/80 border-border animate-header-in pointer-events-auto flex h-14 flex-none items-center rounded-full border backdrop-blur-md";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<!--
  Floating header, single-pill style:
  [ avatar | nav items with sliding dark indicator ]  [ utilities island ]

  transition:persist keeps this DOM alive across View Transitions, so the
  header (and its animations/state) never "reloads" when navigating pages.
  Active-link highlighting is refreshed by JS on astro:after-swap instead.

  Scroll states (set via JS):
    data-scrolled → islands slide inwards, towards the centered nav
    data-hidden   → scrolled far down + still scrolling → everything hides
-->
<header
  id="site-header"
  transition:persist="site-header"
  data-base={import.meta.env.BASE_URL}
  data-locale-prefix={localePrefix}
  class="pointer-events-none fixed inset-x-0 top-3 z-40"
>
  <div class="header-shell flex items-center justify-between gap-3 px-4 sm:px-5">
    <!-- Main island: avatar + nav (desktop) / avatar + menu btn (mobile) -->
    <div class:list={[island, "gap-2 py-1.5 ps-1.5 pe-1.5 sm:ps-2 sm:pe-2"]}>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="focus-outline text-foreground hover:text-accent group relative z-10 grid size-11 flex-none place-items-center rounded-full transition-colors duration-200"
        aria-label={site.title}
      >
        <Logo
          class="size-9 flex-none transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        />
      </a>

      <nav id="site-nav" class="relative hidden sm:block" aria-label={site.title}>
        <ul class="relative flex items-center gap-0.5">
          <!-- Sliding dark indicator behind the hovered/active nav item -->
          <span
            aria-hidden="true"
            class="absolute inset-y-0 left-0 z-0 rounded-full opacity-0"
            id="nav-indicator"
          >
          </span>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "")}
              class:list={[navItem, "max-md:hidden"]}
              data-nav-path="/"
              data-active={isHome ? "true" : "false"}
            >
              <IconHome class="nav-icon size-4" aria-hidden="true" />
              {t.nav.home}
            </a>
          </li>
          <!--
            Grouped item: a button, not a link, so it never navigates — it only
            opens the submenu. The <li> must stay static (not `relative`): the
            sliding indicator measures offsetLeft against the <ul>, and a
            positioned <li> would re-root offsetParent and pin the pill to x=0.
            The panel inherits the <ul> as its containing block, so it shares
            the indicator's coordinate space.
          -->
          <li data-nav-group>
            <button
              type="button"
              class:list={[navItem]}
              data-nav-path={groupNavPaths}
              data-active={isGroupActive ? "true" : "false"}
              aria-expanded="false"
              aria-controls="nav-submenu-content"
            >
              <IconFileText class="nav-icon size-4" aria-hidden="true" />
              {t.nav.content}
              <IconChevronDown class="nav-caret size-3.5" aria-hidden="true" />
            </button>
            <ul
              id="nav-submenu-content"
              data-nav-submenu
              class="border-border bg-background/95 absolute z-30 hidden flex-col gap-0.5 rounded-2xl border p-1.5 shadow-lg backdrop-blur-md"
            >
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "posts")}
                  class="hover:bg-muted/60 flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                  data-nav-path="/posts"
                  aria-current={isActive("/posts") ? "page" : undefined}
                >
                  <IconFileText class="size-4" aria-hidden="true" />
                  {t.nav.posts}
                </a>
              </li>
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "tags")}
                  class="hover:bg-muted/60 flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                  data-nav-path="/tags"
                  aria-current={isActive("/tags") ? "page" : undefined}
                >
                  <IconHash class="size-4" aria-hidden="true" />
                  {t.nav.tags}
                </a>
              </li>
              {
                features.showArchives && (
                  <li>
                    <a
                      href={getRelativeLocaleUrl(locale, "archives")}
                      class="hover:bg-muted/60 flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                      data-nav-path="/archives"
                      aria-current={
                        isActive("/archives") ? "page" : undefined
                      }
                    >
                      <IconArchive class="size-4" aria-hidden="true" />
                      {t.nav.archives}
                    </a>
                  </li>
                )
              }
            </ul>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class:list={[navItem]}
              data-nav-path="/about"
              data-active={isActive("/about") ? "true" : "false"}
            >
              <IconUser class="nav-icon size-4" aria-hidden="true" />
              {t.nav.about}
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "links")}
              class:list={[navItem]}
              data-nav-path="/links"
              data-active={isActive("/links") ? "true" : "false"}
            >
              <IconLink class="nav-icon size-4" aria-hidden="true" />
              {t.nav.links}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Mobile menu button (only visible nav control on small screens) -->
      <button
        id="menu-btn"
        class="focus-outline relative z-10 grid size-10 place-items-center rounded-full transition-colors duration-200 hover:bg-muted/60 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
    </div>

    <!-- Right island: utilities -->
    <div class:list={[island, "h-14 gap-1 px-2.5"]}>
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class:list={[navIconLink]}
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.themeAuto}
            aria-live="polite"
          >
            <IconMoon class="absolute top-1/2 left-1/2 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-1/2 left-1/2 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </div>
  </div>

  <!-- Mobile: dropdown panel below the island.
       pointer-events-auto is required: the header is pointer-events-none and
       this panel is its direct child, so without it the whole menu is
       unclickable (pointer-events is inherited). -->
  <ul
    id="menu-items"
    class="border-border bg-background/95 animate-menu-in pointer-events-auto absolute inset-x-4 top-full z-40 mt-2 hidden flex-col gap-1 rounded-3xl border p-3 backdrop-blur-md sm:hidden"
  >
    <li>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class:list={[
          "block rounded-2xl px-4 py-2.5 font-medium transition-colors hover:text-foreground",
          { "active-nav": isHome },
        ]}
        data-nav-path="/"
      >
        {t.nav.home}
      </a>
    </li>
    <!-- Grouped like the desktop nav: posts/tags/archives sit in a nested
         list that collapses under one parent. -->
    <li data-menu-group>
      <button
        type="button"
        id="menu-group-btn"
        class="flex w-full items-center justify-between gap-2 rounded-2xl px-4 py-2.5 text-start font-medium transition-colors hover:text-foreground"
        aria-expanded={isGroupActive ? "true" : "false"}
        aria-controls="menu-group-items"
      >
        {t.nav.content}
        <IconChevronDown class="nav-caret size-4" aria-hidden="true" />
      </button>
      <ul
        id="menu-group-items"
        class="border-border ms-3 hidden flex-col gap-1 border-s ps-2"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "block rounded-2xl px-3 py-2 font-medium transition-colors hover:text-foreground",
              { "active-nav": isActive("/posts") },
            ]}
            data-nav-path="/posts"
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={[
              "block rounded-2xl px-3 py-2 font-medium transition-colors hover:text-foreground",
              { "active-nav": isActive("/tags") },
            ]}
            data-nav-path="/tags"
          >
            {t.nav.tags}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "block rounded-2xl px-3 py-2 font-medium transition-colors hover:text-foreground",
                  { "active-nav": isActive("/archives") },
                ]}
                data-nav-path="/archives"
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
      </ul>
    </li>
    <li>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "block rounded-2xl px-4 py-2.5 font-medium transition-colors hover:text-foreground",
          { "active-nav": isActive("/about") },
        ]}
        data-nav-path="/about"
      >
        {t.nav.about}
      </a>
    </li>
    <li>
      <a
        href={getRelativeLocaleUrl(locale, "links")}
        class:list={[
          "block rounded-2xl px-4 py-2.5 font-medium transition-colors hover:text-foreground",
          { "active-nav": isActive("/links") },
        ]}
        data-nav-path="/links"
      >
        {t.nav.links}
      </a>
    </li>
  </ul>
</header>

<style>
  /* Sliding indicator: a dark pill gliding between nav items.
     Position/width are set from JS (transform + width).
     Colors are declared here (not via utility classes) so the inverted
     text is guaranteed to contrast with the pill in both themes. */
  #nav-indicator {
    background: var(--foreground);
    inset-block: 0;
    left: 0;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease;
  }

  /* Inverted text while the dark indicator sits behind a nav item. */
  .nav-item.nav-inverted {
    color: var(--background);
  }

  .nav-item:hover:not(.nav-inverted) {
    color: var(--foreground);
  }

  /* Click feedback: icon squashes while the item is pressed. */
  .nav-item .nav-icon {
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      stroke-width 0.18s ease;
  }

  .nav-item:active .nav-icon {
    transform: scale(0.72) rotate(-8deg);
  }

  /* Desktop submenu panel. Its containing block is the nav <ul>, which is the
     same origin the indicator already measures offsetLeft against, so JS sets
     `left` in that space. Centring is done with arithmetic rather than
     translateX(-50%) because animate-menu-in owns `transform` on this element
     and would clobber it. The 1.25rem lands the panel 8px below the pill —
     the <ul> box stops 12px short of the pill's bottom edge, and 8px matches
     the mobile menu's own gap. */
  [data-nav-submenu] {
    top: calc(100% + 1.25rem);
  }

  /* Caret points down and flips when the group is open. It deliberately is
     not `.nav-icon`, whose :active squash (above) fights the flip. */
  .nav-caret {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [aria-expanded="true"] .nav-caret {
    transform: rotate(180deg);
  }

  /* Click pop: the dark indicator bounces once when an item is clicked. */
  #nav-indicator.indicator-pop {
    animation: indicator-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes indicator-pop {
    0% {
      transform: translateX(var(--indicator-x, 0)) scale(1);
    }
    40% {
      transform: translateX(var(--indicator-x, 0)) scale(1.12);
    }
    100% {
      transform: translateX(var(--indicator-x, 0)) scale(1);
    }
  }

  /* Converge: growing inline padding slides the islands towards
     the centered nav pill while the nav itself stays put. */
  .header-shell {
    padding-inline: 1rem;
    transition:
      padding-inline 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  @media (min-width: 640px) {
    .header-shell {
      padding-inline: 1.25rem;
    }

    #site-header[data-scrolled] .header-shell {
      padding-inline: clamp(4rem, 12vw, 10rem);
    }
  }

  /* Subtle converge on small screens (islands are nearly touching already). */
  @media (max-width: 639px) {
    #site-header[data-scrolled] .header-shell {
      padding-inline: 1.5rem;
    }
  }

  /* Hide: scrolled far down and still going → slide up out of view. */
  #site-header[data-hidden] .header-shell {
    transform: translateY(-150%);
    opacity: 0;
  }

  /* The persisted header node is re-inserted into the DOM on every
     navigation, and re-insertion restarts CSS animations. Once the first
     entrance has played (marked via data-entered from JS), the entrance
     animation must never replay — the header should look "frozen" across
     route changes, only the page content switches. */
  #site-header[data-entered] .animate-header-in {
    animation: none;
  }

  /* Mobile menu: neutral active/hover emphasis (no theme colour). */
  #menu-items .active-nav {
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-shell {
      transition: opacity 0.3s ease;
    }

    #nav-indicator {
      transition: opacity 0.2s ease;
    }

    .nav-item .nav-icon,
    .nav-item:active .nav-icon {
      transition: none;
      transform: none;
    }

    /* The caret keeps its flipped state — it signals whether the submenu is
       open — but snaps instead of rotating. */
    .nav-caret {
      transition: none;
    }

    #nav-indicator.indicator-pop {
      animation: none;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // NOTE: the <header> uses transition:persist, so its DOM survives View
  // Transitions. Every setup() below must therefore be IDEMPOTENT (guarded
  // with a data-flag) — after-swap handlers re-run against the *same* nodes.
  // ---------------------------------------------------------------------------

  // Resolve a raw URL path (e.g. "/zh/posts/x/" or "/blog/en/posts/")
  // against the configured base + locale prefix → "" or "/posts/x".
  function resolveNavPath(header: HTMLElement, rawPath: string): string {
    const base = header.dataset.base || "/";
    const localePrefix = header.dataset.localePrefix || "";
    let path = rawPath;
    if (base && base !== "/" && path.startsWith(base)) {
      path = path.slice(base.length);
    }
    if (localePrefix && path.startsWith(localePrefix)) {
      path = path.slice(localePrefix.length);
    }
    return path.replace(/\/+$/, "");
  }

  // Refresh active-link highlighting from the current location.
  // Runs on load and after every astro:after-swap (the persisted header keeps
  // stale server-rendered state otherwise).
  function updateHeaderActive() {
    const header = document.getElementById("site-header");
    if (!header) return;

    const currentPath = resolveNavPath(header, window.location.pathname);
    const firstSegment = (p: string) => p.split("/").filter(Boolean)[0] ?? "";

    // data-nav-path may list several paths (comma-separated) for grouped
    // nav items, e.g. the Posts group covering /posts, /tags and /archives.
    const matchesNavPath = (el: HTMLElement) =>
      (el.dataset.navPath || "/")
        .split(",")
        .map(p => p.trim())
        .filter(Boolean)
        .some(navPathRaw => {
          const navPath = resolveNavPath(header, navPathRaw);
          return (
            currentPath === navPath ||
            firstSegment(currentPath) === firstSegment(navPath)
          );
        });

    header
      .querySelectorAll<HTMLElement>("[data-nav-path]")
      .forEach(el => {
        const active = matchesNavPath(el);

        if (el.classList.contains("nav-item")) {
          if (active) el.setAttribute("data-active", "true");
          else el.removeAttribute("data-active");
        } else {
          el.classList.toggle("active-nav", active);
        }

        // Only real links get the current-page marking. The grouped item is a
        // <button> that merely *contains* the current page, so the matching
        // link inside its submenu carries it instead.
        if (active && el.tagName === "A")
          el.setAttribute("aria-current", "page");
        else el.removeAttribute("aria-current");
      });

    // Glide the indicator onto the (visible) active nav item.
    const nav = document.getElementById("site-nav");
    if (!nav) return;

    const items = [...nav.querySelectorAll<HTMLElement>(".nav-item")];
    if (items.length === 0) return;
    const visible = items.filter(item => item.offsetParent !== null);
    const pool = visible.length > 0 ? visible : items;
    const target =
      pool.find(item => item.getAttribute("data-active") === "true") ?? pool[0];
    if (target) moveIndicator(target);

    positionNavSubmenus();
  }

  // Glide the indicator pill onto a nav item and invert its text.
  function moveIndicator(item: HTMLElement) {
    const nav = document.getElementById("site-nav");
    const indicator = document.getElementById("nav-indicator");
    if (!nav || !indicator) return;

    const x = `${item.offsetLeft}px`;
    // Keep the custom property in sync so the pop keyframe can reuse it.
    indicator.style.setProperty("--indicator-x", x);
    indicator.style.width = `${item.offsetWidth}px`;
    indicator.style.transform = `translateX(${x})`;
    nav
      .querySelectorAll<HTMLElement>(".nav-item")
      .forEach(l => l.classList.toggle("nav-inverted", l === item));
  }

  // Centre each submenu under its group button. The button and the panel both
  // resolve against the nav <ul>, so offsetLeft/offsetWidth and the panel's
  // `left` already share a coordinate space. A closed panel is display:none and
  // reports width 0, so this only has an effect once it is open.
  function positionNavSubmenus() {
    document
      .querySelectorAll<HTMLElement>("[data-nav-group]")
      .forEach(group => {
        const button = group.querySelector<HTMLElement>(".nav-item");
        const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
        if (!button || !panel) return;
        const centre = button.offsetLeft + button.offsetWidth / 2;
        panel.style.left = `${centre - panel.offsetWidth / 2}px`;
      });
  }

  // The nav item for the page you are already on keeps its <a> markup, hover
  // glide and click feedback, but must not navigate — clicking it would just
  // reload the same page. Blocked here rather than in CSS so the item stays
  // fully interactive apart from the navigation itself.
  function guardNavClicks() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.navGuard === "true") return;
    header.dataset.navGuard = "true";

    header.addEventListener("click", e => {
      const target = e.target as HTMLElement | null;
      const link = target?.closest<HTMLAnchorElement>("a[data-nav-path]");
      if (!link) return;

      const isCurrent =
        link.getAttribute("data-active") === "true" ||
        link.classList.contains("active-nav");
      if (!isCurrent) return;

      e.preventDefault();
      // No indicator bounce on mobile, so closing the tap-away menu is the
      // only acknowledgement that the tap registered.
      if (link.closest("#menu-items")) closeMenus();
    });
  }

  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    const groupBtn = document.querySelector<HTMLButtonElement>(
      "#menu-group-btn"
    );
    if (groupBtn && groupBtn.dataset.bound !== "true") {
      groupBtn.dataset.bound = "true";
      groupBtn.addEventListener("click", () =>
        toggleMenuGroup(groupBtn.getAttribute("aria-expanded") !== "true")
      );
    }

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;
    if (menuBtn.dataset.bound === "true") return;
    menuBtn.dataset.bound = "true";

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      // Rounded panel dropping below the floating island on mobile.
      menuItems.classList.toggle("hidden", openMenu);
      menuItems.classList.toggle("flex", !openMenu);
      menuItems.classList.toggle("animate-menu-in", !openMenu);
      menuIcon.classList.toggle("hidden", !openMenu);
      closeIcon.classList.toggle("hidden", openMenu);

      // On the way in, reveal the group if the current page is inside it —
      // otherwise the page you are on stays hidden behind a collapsed parent.
      // Done here, on the user's own action, rather than in updateHeaderActive
      // (which also runs on resize and would fight a manual collapse).
      if (!openMenu && menuGroupHasActivePage()) toggleMenuGroup(true);
    });
  }

  function menuGroupHasActivePage() {
    return !!document.querySelector(
      "#menu-group-items [data-nav-path].active-nav"
    );
  }

  function toggleMenuGroup(open: boolean) {
    const groupBtn = document.querySelector<HTMLButtonElement>(
      "#menu-group-btn"
    );
    const groupItems = document.querySelector("#menu-group-items");
    if (!groupBtn || !groupItems) return;

    groupBtn.setAttribute("aria-expanded", open ? "true" : "false");
    groupItems.classList.toggle("hidden", !open);
    groupItems.classList.toggle("flex", open);
    groupItems.classList.toggle("animate-menu-in", open);
  }

  // Close the mobile menu (e.g. after navigating with it open). The group
  // collapses with it, so reopening always starts from a known state.
  function closeMenus() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (menuBtn && menuItems && menuIcon && closeIcon) {
      menuBtn.setAttribute("aria-expanded", "false");
      menuItems.classList.add("hidden");
      menuItems.classList.remove("flex");
      menuIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
    }

    toggleMenuGroup(false);
  }

  // How long the submenu lingers after the pointer leaves the group, so it can
  // be crossed from the button down to the panel without snapping shut.
  const GROUP_CLOSE_DELAY = 150;

  // Grouped nav item: hover, click, Escape and focus handling for its submenu.
  // Bound inside setupNavIndicator's nav-level guard, since the header persists.
  function setupNavGroups(nav: HTMLElement) {
    nav.querySelectorAll<HTMLElement>("[data-nav-group]").forEach(group => {
      if (group.dataset.bound === "true") return;
      group.dataset.bound = "true";

      const button = group.querySelector<HTMLButtonElement>(".nav-item");
      const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
      if (!button || !panel) return;

      let closeTimer = 0;
      // A pointer that has hovered the group open is already looking at the
      // panel, so its click must not toggle that away — it would mean every
      // mouse click closed what the hover had just revealed.
      let openedByHover = false;

      const isOpen = () => button.getAttribute("aria-expanded") === "true";

      const open = (byHover = false) => {
        window.clearTimeout(closeTimer);
        if (isOpen()) return;
        openedByHover = byHover;
        button.setAttribute("aria-expanded", "true");
        panel.classList.remove("hidden");
        panel.classList.add("flex", "animate-menu-in");
        moveIndicator(button);
        positionNavSubmenus();
      };

      const close = () => {
        window.clearTimeout(closeTimer);
        if (!isOpen()) return;
        openedByHover = false;
        button.setAttribute("aria-expanded", "false");
        panel.classList.add("hidden");
        panel.classList.remove("flex", "animate-menu-in");
        updateHeaderActive();
      };

      const closeSoon = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(close, GROUP_CLOSE_DELAY);
      };

      // Only a real mouse hovers. Touch pointers would otherwise open the panel
      // on tap and then close it again when pointerleave fires as the finger
      // lifts — they toggle through the click handler instead.
      group.addEventListener("pointerenter", e => {
        if (e.pointerType === "mouse") open(true);
      });
      group.addEventListener("pointerleave", e => {
        if (e.pointerType === "mouse") closeSoon();
      });

      button.addEventListener("click", () => {
        if (openedByHover) return;
        if (isOpen()) close();
        else open();
      });

      group.addEventListener("keydown", e => {
        if (e.key !== "Escape" || !isOpen()) return;
        close();
        button.focus();
      });

      // Tabbing into the panel keeps the group open; leaving it closes. The
      // read is deferred because focusout fires before focus lands.
      group.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (!group.contains(document.activeElement)) close();
        });
      });

      // Any panel click closes the group: a link that navigates is finished
      // with it, and a link to the current page (whose navigation
      // guardNavClicks blocks) at least gets the collapse as feedback.
      panel.addEventListener("click", close);
    });
  }

  // Collapse the desktop submenus. Wired to clicks outside the nav and to
  // view-transition swaps, which would otherwise leave an open panel on screen
  // because the header node is persisted.
  function closeNavGroups() {
    document
      .querySelectorAll<HTMLElement>("[data-nav-group]")
      .forEach(group => {
        const button = group.querySelector<HTMLElement>(".nav-item");
        const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
        if (!button || !panel) return;
        button.setAttribute("aria-expanded", "false");
        panel.classList.add("hidden");
        panel.classList.remove("flex", "animate-menu-in");
      });
  }

  // Clicking anywhere outside a group closes it. Bound to the persisted header
  // rather than `document`, which would re-register a listener on every swap.
  function setupHeaderDismiss() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.dismissBound === "true") return;
    header.dataset.dismissBound = "true";

    header.addEventListener("click", e => {
      const target = e.target as HTMLElement | null;
      if (target?.closest("[data-nav-group]")) return;
      closeNavGroups();
    });
  }

  // Sliding nav indicator: a dark pill that glides to the hovered item
  // and settles back on the active one when the pointer leaves.
  function setupNavIndicator() {
    const nav = document.getElementById("site-nav");
    const indicator = document.getElementById("nav-indicator");
    if (!nav || !indicator) return;

    if (nav.dataset.bound !== "true") {
      nav.dataset.bound = "true";

      nav.querySelectorAll<HTMLElement>(".nav-item").forEach(item => {
        item.addEventListener("mouseenter", () => moveIndicator(item));
        // Click pop: replay the indicator bounce animation.
        item.addEventListener("click", () => {
          indicator.classList.remove("indicator-pop");
          void indicator.offsetWidth; // restart the animation
          indicator.classList.add("indicator-pop");
        });
      });
      indicator.addEventListener("animationend", () => {
        indicator.classList.remove("indicator-pop");
      });
      nav.addEventListener("mouseleave", () => {
        // While a submenu is open the pointer often leaves the nav through the
        // gap between the button and the panel; settling the pill back then
        // would make it flicker away from the open group.
        if (nav.querySelector('[aria-expanded="true"]')) return;
        updateHeaderActive();
      });

      setupNavGroups(nav);
    }

    // Initial placement, re-measure once fonts settle.
    updateHeaderActive();
    indicator.style.opacity = "1";
    document.fonts?.ready.then(() => updateHeaderActive());
    window.addEventListener("resize", () => updateHeaderActive());
  }

  // Floating header scroll behaviour:
  //  1. scrolled a little  → islands converge towards the nav (data-scrolled)
  //  2. scrolled far + still going down → slide up and hide (data-hidden)
  //  3. any upward scroll  → reappear
  function handleHeaderScroll() {
    const header = document.getElementById("site-header");
    if (!header) return;

    let lastY = window.scrollY;

    const onScroll = () => {
      const current = document.getElementById("site-header");
      if (!current) return;
      const y = window.scrollY;

      if (y > 24) current.setAttribute("data-scrolled", "");
      else current.removeAttribute("data-scrolled");

      const delta = y - lastY;
      if (y > 260 && delta > 4) {
        current.setAttribute("data-hidden", "");
      } else if (delta < -4 || y <= 260) {
        current.removeAttribute("data-hidden");
      }
      lastY = y;
    };

    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    if (skipLink.dataset.bound === "true") return;
    skipLink.dataset.bound = "true";

    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // The header uses transition:persist, so its DOM node is kept alive but
  // RE-INSERTED on every navigation — which restarts CSS animations (the
  // entrance slide-in would replay on each route change, looking like the
  // header "reloads"). Mark the node once the entrance has played; the
  // attribute travels with the persisted node across swaps, and the CSS
  // rule above then suppresses the entrance animation for good.
  function markHeaderEntered() {
    const header = document.getElementById("site-header");
    if (!header) return;
    header.dataset.entered = "true";
    // Clear a half-finished click-pop so re-insertion cannot restart it.
    document.getElementById("nav-indicator")?.classList.remove("indicator-pop");
  }
  document.addEventListener("astro:after-swap", markHeaderEntered);
  // Initial page load: let the entrance animation finish once, then mark.
  window.addEventListener("load", () => setTimeout(markHeaderEntered, 600));

  guardNavClicks();
  setupHeaderDismiss();

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  setupNavIndicator();
  document.addEventListener("astro:after-swap", setupNavIndicator);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);

  // The persisted header keeps stale active state across navigations —
  // refresh it (and close menus) after each swap. Without closing the groups
  // here, an open submenu would ride along to the next page.
  document.addEventListener("astro:after-swap", () => {
    closeNavGroups();
    updateHeaderActive();
    closeMenus();
  });

  // Bound once on `document` (persists across view transitions); the handler
  // looks up the current header element on every event.
  if (!(window as unknown as { __headerScrollBound?: boolean }).__headerScrollBound) {
    (window as unknown as { __headerScrollBound?: boolean }).__headerScrollBound =
      true;
    handleHeaderScroll();
  }
</script>
