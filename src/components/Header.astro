---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconHome from "@/assets/icons/IconHome.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import IconLink from "@/assets/icons/IconLink.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconChevronDown from "@/assets/icons/IconChevronDown.svg";
import Logo from "@/assets/icons/Logo.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { daysUntil } from "@/utils/siteAge";
import { getSiteStats } from "@/utils/getSiteStats";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

const { site, features, hero } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Locale URL prefix used by the client-side active-link resolver.
// astro.config.ts: routing.prefixDefaultLocale = false and only "zh" exists,
// so the default locale has no URL prefix. When a prefixed secondary locale
// (e.g. "en") is added, this must become `/${locale}` for that locale.
const localePrefix = "";

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isHome = currentPath === "" || currentPath === "/";

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The "content" nav entry groups posts/tags/archives behind one submenu, so it
// counts as active when any of its children is the current page. The
// comma-separated list is the format the client-side resolver already expects.
const groupPaths = [
  "/posts",
  "/tags",
  ...(features.showArchives ? ["/archives"] : []),
];
const groupNavPaths = groupPaths.join(",");
const isGroupActive = groupPaths.some(isActive);

const navItem =
  "nav-item relative z-10 flex items-center gap-1.5 rounded-md px-3.5 py-2 text-[13px] leading-none font-semibold tracking-[0.02em] whitespace-nowrap transition-[color,transform,background-color] duration-200 active:scale-[0.96]";
const navIconLink =
  "relative grid size-9 place-items-center rounded-md transition-all duration-200 hover:bg-muted hover:text-foreground active:scale-95 max-sm:size-10";
const island =
  "surface-panel animate-header-in pointer-events-auto flex h-14 flex-none items-center rounded-xl";

// --- Dynamic island ---------------------------------------------------------
// Gated on hero.enabled: every value and string it shows is hero-derived, so
// the hero's existing switch also removes the island. No new config surface.
const showIsland = hero.enabled;
const islandStats = showIsland ? await getSiteStats() : null;

const islandNow = new Date();

// h23 rather than hour12:false, which renders "24:00" at midnight in some engines.
const islandClockFmt = new Intl.DateTimeFormat(locale, {
  hour: "2-digit",
  minute: "2-digit",
  hourCycle: "h23",
});
const islandEventDays = hero.event
  ? daysUntil(hero.event.date, site.timezone, islandNow)
  : null;
// The space before the unit is what makes this read correctly in both
// languages ("中秋 6 天" / "6 days", not "6days").
const islandCountdownTemplate = hero.event
  ? `${hero.event.name} {{days}} ${t.hero.unitDay}`
  : "";
// No key for "today" / "it has passed", so the countdown simply steps aside.
const islandHasCountdown = islandEventDays !== null && islandEventDays > 0;
const islandCountdownText = islandHasCountdown
  ? tplStr(islandCountdownTemplate, { days: islandEventDays })
  : "";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-foreground absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<!--
  Floating header, single-pill style:
  [ avatar | nav items with sliding dark indicator ]  [ utilities island ]

  transition:persist keeps this DOM alive across View Transitions, so the
  header (and its animations/state) never "reloads" when navigating pages.
  Active-link highlighting is refreshed by JS on astro:after-swap instead.

  Scroll states (set via JS):
    data-scrolled → islands slide inwards, towards the centered nav
    data-hidden   → scrolled far down + still scrolling → everything hides
-->
<header
  id="site-header"
  transition:persist="site-header"
  data-base={import.meta.env.BASE_URL}
  data-locale-prefix={localePrefix}
  class="pointer-events-none fixed inset-x-0 top-3 z-40"
>
  <div
    class="header-shell flex items-center justify-between gap-3 px-4 sm:px-5"
  >
    <!-- Main island: avatar + nav (desktop) / menu btn only (mobile) -->
    <div class:list={[island, "gap-2 py-1.5 ps-1.5 pe-1.5 sm:ps-2 sm:pe-2"]}>
      <!-- Hidden on mobile: the drawer's own top bar carries the brand, and the
           logo would otherwise sit pointlessly next to the hamburger. -->
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="focus-outline text-foreground hover:text-foreground/70 group relative z-10 grid size-11 flex-none place-items-center rounded-lg transition-colors duration-200 max-sm:hidden"
        aria-label={site.title}
      >
        <Logo
          class="size-9 flex-none transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        />
      </a>

      <nav
        id="site-nav"
        class="relative hidden sm:block"
        aria-label={site.title}
      >
        <ul class="relative flex items-center gap-0.5">
          <!-- Sliding dark indicator behind the active nav item -->
          <span
            aria-hidden="true"
            class="absolute inset-y-0 left-0 z-0 rounded-md opacity-0"
            id="nav-indicator"
          >
          </span>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "")}
              class:list={[navItem, "max-md:hidden"]}
              data-nav-path="/"
              data-active={isHome ? "true" : "false"}
            >
              <IconHome class="nav-icon size-4" aria-hidden="true" />
              {t.nav.home}
            </a>
          </li>
          <!--
            Grouped item: a button, not a link, so it never navigates — it only
            opens the submenu. The <li> must stay static (not `relative`): the
            sliding indicator measures offsetLeft against the <ul>, and a
            positioned <li> would re-root offsetParent and pin the pill to x=0.
            The panel inherits the <ul> as its containing block, so it shares
            the indicator's coordinate space.
          -->
          <li data-nav-group>
            <button
              type="button"
              class:list={[navItem]}
              data-nav-path={groupNavPaths}
              data-active={isGroupActive ? "true" : "false"}
              aria-expanded="false"
              aria-controls="nav-submenu-content"
            >
              <IconFileText class="nav-icon size-4" aria-hidden="true" />
              {t.nav.content}
              <IconChevronDown class="nav-caret size-3.5" aria-hidden="true" />
            </button>
            <ul
              id="nav-submenu-content"
              data-nav-submenu
              class="surface-panel absolute z-30 hidden flex-col gap-0.5 rounded-lg p-1.5 shadow-lg"
            >
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "posts")}
                  class="hover:bg-muted flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                  data-nav-path="/posts"
                  aria-current={isActive("/posts") ? "page" : undefined}
                >
                  <IconFileText class="size-4" aria-hidden="true" />
                  {t.nav.posts}
                </a>
              </li>
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "tags")}
                  class="hover:bg-muted flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                  data-nav-path="/tags"
                  aria-current={isActive("/tags") ? "page" : undefined}
                >
                  <IconHash class="size-4" aria-hidden="true" />
                  {t.nav.tags}
                </a>
              </li>
              {
                features.showArchives && (
                  <li>
                    <a
                      href={getRelativeLocaleUrl(locale, "archives")}
                      class="hover:bg-muted flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors"
                      data-nav-path="/archives"
                      aria-current={isActive("/archives") ? "page" : undefined}
                    >
                      <IconArchive class="size-4" aria-hidden="true" />
                      {t.nav.archives}
                    </a>
                  </li>
                )
              }
            </ul>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class:list={[navItem]}
              data-nav-path="/about"
              data-active={isActive("/about") ? "true" : "false"}
            >
              <IconUser class="nav-icon size-4" aria-hidden="true" />
              {t.nav.about}
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "links")}
              class:list={[navItem]}
              data-nav-path="/links"
              data-active={isActive("/links") ? "true" : "false"}
            >
              <IconLink class="nav-icon size-4" aria-hidden="true" />
              {t.nav.links}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Mobile menu button (only visible nav control on small screens) -->
      <button
        id="menu-btn"
        class="focus-outline hover:bg-muted relative z-10 grid size-10 place-items-center rounded-lg transition-colors duration-200 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
    </div>

    <!-- Right island: utilities. Hidden on mobile — the theme toggle moves into
         the drawer, and this would otherwise be an empty pill. -->
    {
      features.lightAndDarkMode && (
        <div class:list={[island, "h-14 gap-1 px-2.5 max-sm:hidden"]}>
          <button
            id="theme-btn"
            data-theme-toggle
            class:list={[navIconLink]}
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.themeAuto}
            aria-live="polite"
          >
            <IconMoon class="absolute top-1/2 left-1/2 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-1/2 left-1/2 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        </div>
      )
    }

    <!-- Dynamic island: a live clock + festival countdown that MORPHS IN PLACE
         into a wider capsule of site stats. The component itself changes size
         and position — there is no separate panel — and it stays visible when
         the page scrolls.

         Centring is flexbox, never translateX(-50%): `transform` must stay free
         for the pill's animate-header-in, which owns it. `inset-x-0` spans the
         shell's PADDING box, which does not change when data-scrolled grows
         padding-inline — so the pill stays dead-centre while the two flex-none
         islands converge inwards.

         Both content layers are absolutely positioned so neither contributes
         width, and the inactive one is `visibility: hidden`: that keeps it out
         of the button's accessible name (a button's name is its text content)
         as well as out of the tab order. -->
    {
      showIsland && islandStats && (
        <div
          id="island-slot"
          data-tz={site.timezone}
          data-since={hero.since}
          data-event={hero.event?.date ?? ""}
          class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden h-14 items-start justify-center xl:flex"
        >
          {/* The button holds two absolutely stacked layers — the collapsed
              clock + countdown, and the expanded clock + four stats — and the
              stylesheet cross-fades between them while the button's own width
              and height transition. */}
          <button
            id="island-btn"
            type="button"
            class="bg-background/80 border-border animate-header-in pointer-events-auto relative h-14 w-[9.5rem] flex-none overflow-hidden rounded-full border backdrop-blur-md"
            aria-expanded="false"
          >
            <span class="island-layer island-compact absolute inset-0 flex items-center justify-center gap-1.5 text-[13px] leading-none font-medium">
              <time data-island-clock class="text-foreground tabular-nums">
                {islandClockFmt.format(islandNow)}
              </time>
              <span
                data-island-event
                class:list={[
                  "items-center gap-1.5",
                  islandHasCountdown ? "flex" : "hidden",
                ]}
              >
                <span class="text-border" aria-hidden="true">
                  &#183;
                </span>
                <span
                  data-island-countdown
                  data-template={islandCountdownTemplate}
                  class="text-muted-foreground"
                >
                  {islandCountdownText}
                </span>
              </span>
            </span>

            <span class="island-layer island-detail absolute inset-0 flex items-center justify-center gap-3">
              <time
                data-island-clock
                class="text-foreground text-[15px] leading-none font-semibold tabular-nums"
              >
                {islandClockFmt.format(islandNow)}
              </time>
              <span class="bg-border h-7 w-px" aria-hidden="true" />
              <span class="flex items-start gap-3">
                <span class="flex flex-col items-center">
                  <span class="text-foreground text-sm leading-none font-semibold tabular-nums">
                    {islandStats.totalPosts}
                  </span>
                  <span class="text-muted-foreground mt-1.5 text-[10px] leading-none">
                    {t.hero.statPosts}
                  </span>
                </span>
                <span class="flex flex-col items-center">
                  <span class="text-foreground text-sm leading-none font-semibold tabular-nums">
                    {islandStats.activeDays}
                  </span>
                  <span class="text-muted-foreground mt-1.5 text-[10px] leading-none">
                    {t.hero.statActiveDays}
                  </span>
                </span>
                <span class="flex flex-col items-center">
                  <span class="text-foreground text-sm leading-none font-semibold tabular-nums">
                    {islandStats.thisMonth}
                  </span>
                  <span class="text-muted-foreground mt-1.5 text-[10px] leading-none">
                    {t.hero.statThisMonth}
                  </span>
                </span>
                <span class="flex flex-col items-center">
                  <span class="text-foreground text-sm leading-none font-semibold tabular-nums">
                    {islandStats.longestStreak}
                  </span>
                  <span class="text-muted-foreground mt-1.5 text-[10px] leading-none">
                    {t.hero.statLongestStreak}
                  </span>
                </span>
              </span>
            </span>
          </button>
        </div>
      )
    }
  </div>

  <!-- Mobile drawer: slides in from the inline-start edge.
       Both nodes are siblings of .header-shell, never children of it: the shell
       transitions `transform`, and a transformed ancestor becomes the
       containing block for position:fixed descendants — the drawer would be
       clipped into the pill. #site-header itself has no transform, so `fixed`
       resolves against the viewport.
       pointer-events-auto is required on both: the header is
       pointer-events-none and the property is inherited. -->
  <div
    id="menu-backdrop"
    aria-hidden="true"
    class="pointer-events-auto fixed inset-0 z-30 bg-black/40 opacity-0 backdrop-blur-sm transition-opacity duration-300 sm:hidden"
  >
  </div>

  <div
    id="menu-items"
    role="dialog"
    aria-modal="true"
    aria-label={t.nav.menu}
    class="surface-panel pointer-events-auto fixed inset-s-0 top-0 z-40 flex h-dvh w-72 max-w-[85vw] flex-col gap-1 overflow-y-auto overscroll-contain border-e p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-xl sm:hidden"
  >
    <div class="flex items-center justify-between gap-2 pb-1">
      <span class="px-2 text-sm font-semibold">{site.title}</span>
      <button
        id="drawer-close-btn"
        type="button"
        class="focus-outline hover:bg-muted/60 grid size-10 place-items-center rounded-full transition-colors duration-200"
        aria-label={t.a11y.closeMenu}
      >
        <IconX class="size-5" aria-hidden="true" />
      </button>
    </div>

    <ul class="flex flex-col gap-1">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class:list={[
            "hover:text-foreground block rounded-md px-4 py-2.5 font-medium transition-colors",
            { "active-nav": isHome },
          ]}
          data-nav-path="/"
        >
          {t.nav.home}
        </a>
      </li>
      <!-- Grouped like the desktop nav: posts/tags/archives sit in a nested
         list that collapses under one parent. -->
      <li data-menu-group>
        <button
          type="button"
          id="menu-group-btn"
          class="hover:text-foreground flex w-full items-center justify-between gap-2 rounded-md px-4 py-2.5 text-start font-medium transition-colors"
          aria-expanded={isGroupActive ? "true" : "false"}
          aria-controls="menu-group-items"
        >
          {t.nav.content}
          <IconChevronDown class="nav-caret size-4" aria-hidden="true" />
        </button>
        <ul
          id="menu-group-items"
          class="border-border ms-3 hidden flex-col gap-1 border-s ps-2"
        >
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class:list={[
                "hover:text-foreground block rounded-md px-3 py-2 font-medium transition-colors",
                { "active-nav": isActive("/posts") },
              ]}
              data-nav-path="/posts"
            >
              {t.nav.posts}
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "tags")}
              class:list={[
                "hover:text-foreground block rounded-md px-3 py-2 font-medium transition-colors",
                { "active-nav": isActive("/tags") },
              ]}
              data-nav-path="/tags"
            >
              {t.nav.tags}
            </a>
          </li>
          {
            features.showArchives && (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "archives")}
                  class:list={[
                    "hover:text-foreground block rounded-md px-3 py-2 font-medium transition-colors",
                    { "active-nav": isActive("/archives") },
                  ]}
                  data-nav-path="/archives"
                >
                  {t.nav.archives}
                </a>
              </li>
            )
          }
        </ul>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class:list={[
            "hover:text-foreground block rounded-md px-4 py-2.5 font-medium transition-colors",
            { "active-nav": isActive("/about") },
          ]}
          data-nav-path="/about"
        >
          {t.nav.about}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "links")}
          class:list={[
            "hover:text-foreground block rounded-md px-4 py-2.5 font-medium transition-colors",
            { "active-nav": isActive("/links") },
          ]}
          data-nav-path="/links"
        >
          {t.nav.links}
        </a>
      </li>
    </ul>

    <!-- Theme toggle, moved out of the header's right island on mobile.
         The sun/moon swap is pure CSS (dark: variant classes) — no JS. -->
    {
      features.lightAndDarkMode && (
        <button
          id="drawer-theme-btn"
          type="button"
          data-theme-toggle
          class="focus-outline hover:bg-muted mt-auto flex w-full items-center justify-between gap-2 rounded-md px-4 py-3 text-start font-medium transition-colors"
          aria-label={t.a11y.toggleTheme}
        >
          <span>{t.nav.theme}</span>
          <span class="relative grid size-5 flex-none place-items-center">
            <IconMoon
              class="absolute top-1/2 left-1/2 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
              aria-hidden="true"
            />
            <IconSunHigh
              class="absolute top-1/2 left-1/2 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
              aria-hidden="true"
            />
          </span>
        </button>
      )
    }
  </div>
</header>

<style>
  /* Sliding indicator: a dark pill gliding between nav items.
     Position/width are set from JS (transform + width).
     Colors are declared here (not via utility classes) so the inverted
     text is guaranteed to contrast with the pill in both themes. */
  #nav-indicator {
    background: var(--foreground);
    inset-block: 0;
    left: 0;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease;
  }

  /* Inverted text while the dark indicator sits behind a nav item. */
  .nav-item.nav-inverted {
    color: var(--background);
  }

  /* Click feedback: icon squashes while the item is pressed. */
  .nav-item .nav-icon {
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      stroke-width 0.18s ease;
  }

  .nav-item:active .nav-icon {
    transform: scale(0.72) rotate(-8deg);
  }

  /* Desktop submenu panel. Its containing block is the nav <ul>, which is the
     same origin the indicator already measures offsetLeft against, so JS sets
     `left` in that space. Centring is done with arithmetic rather than
     translateX(-50%) because animate-menu-in owns `transform` on this element
     and would clobber it. The 1.25rem lands the panel 8px below the pill —
     the <ul> box stops 12px short of the pill's bottom edge, and 8px matches
     the mobile menu's own gap. */
  [data-nav-submenu] {
    top: calc(100% + 1.25rem);
  }

  /* Caret points down and flips when the group is open. It deliberately is
     not `.nav-icon`, whose :active squash (above) fights the flip. */
  .nav-caret {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [aria-expanded="true"] .nav-caret {
    transform: rotate(180deg);
  }

  /* Click pop: the dark indicator bounces once when an item is clicked. */
  #nav-indicator.indicator-pop {
    animation: indicator-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes indicator-pop {
    0% {
      transform: translateX(var(--indicator-x, 0)) scale(1);
    }
    40% {
      transform: translateX(var(--indicator-x, 0)) scale(1.12);
    }
    100% {
      transform: translateX(var(--indicator-x, 0)) scale(1);
    }
  }

  /* Converge: growing inline padding slides the islands towards
     the centered nav pill while the nav itself stays put. */
  .header-shell {
    position: relative;
    /* Current width of the dynamic island, used by the converge cap below. */
    --island-w: 9.5rem;
    padding-inline: 1rem;
    transition:
      padding-inline 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  @media (min-width: 640px) {
    .header-shell {
      padding-inline: 1.25rem;
    }

    /* Converge, capped so it can never reach the dynamic island that now
       occupies the centre. The island is centred, so the room it has on the
       left is `100vw/2 - islandWidth/2 - leftIslandWidth` — the clamp is
       min()'d against exactly that. `27rem` (432px) is the MEASURED width of
       the left island (logo + the four nav items) at xl; re-measure and update
       it if the nav changes. Without the island the old clamp is unchanged. */
    #site-header[data-scrolled] .header-shell {
      padding-inline: min(
        clamp(4rem, 12vw, 10rem),
        max(0px, calc((100vw - var(--island-w)) / 2 - 27rem))
      );
    }
  }

  /* Subtle converge on small screens (islands are nearly touching already). */
  @media (max-width: 639px) {
    #site-header[data-scrolled] .header-shell {
      padding-inline: 1.5rem;
    }
  }

  /* Hide: scrolled far down and still going → slide up out of view. */
  #site-header[data-hidden] .header-shell {
    transform: translateY(-150%);
    opacity: 0;
  }

  /* The persisted header node is re-inserted into the DOM on every
     navigation, and re-insertion restarts CSS animations. Once the first
     entrance has played (marked via data-entered from JS), the entrance
     animation must never replay — the header should look "frozen" across
     route changes, only the page content switches. */
  #site-header[data-entered] .animate-header-in {
    animation: none;
  }

  /* Mobile menu: neutral active/hover emphasis (no theme colour). */
  #menu-items .active-nav {
    color: var(--foreground);
  }

  /* While the drawer is open the whole header — and therefore the backdrop and
     the drawer, which composite as a unit inside its stacking context — rises
     above every root-level z-50 layer (back-to-top, reading progress, the
     lightbox). Without this the z-40 header would trap them all underneath. */
  #site-header[data-drawer-open] {
    z-index: 60;
  }

  /* Closed state is `visibility: hidden`, NOT display:none — the slide-out has
     to animate, and visibility is what keeps the parked drawer out of both the
     tab order and the accessibility tree. It transitions on the standard
     discrete rule: it stays visible for the whole slide-out, then flips. */
  #menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }

  /* The offset must stay in `transform` here: Tailwind v4's translate-*
     utilities compile to the separate `translate` property, so mixing them
     with this transition would put the two in different systems. */
  #menu-items {
    position: fixed;
    inset-inline-start: 0;
    top: 0;
    height: 100dvh;
    z-index: 40;
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.3s;
  }

  /* :global() is required. Astro appends the scope attribute to every compound
     selector, so a bare [dir="rtl"] compiles to [dir="rtl"][data-astro-cid-…],
     which <html> never matches. There is no logical-property transform, so the
     direction is overridden explicitly. */
  :global([dir="rtl"]) #menu-items {
    transform: translateX(100%);
  }

  #site-header[data-drawer-open] #menu-backdrop {
    opacity: 1;
    visibility: visible;
  }

  #site-header[data-drawer-open] #menu-items {
    transform: translateX(0);
    visibility: visible;
  }

  /* Dynamic island: the pill itself grows in place — width and height both
     transition, so the component changes size rather than revealing a separate
     panel. The radius stays fully round, which is what makes the collapsed pill
     and the wide capsule read as the same object. */
  /* The pill's TOP edge is the anchor: the slot aligns to flex-start and the
     pill grows downward from there, so its y position never shifts. The easing
     overshoots (the same back curve the nav icons use) so the capsule springs
     past its final size and settles back — an elastic feel rather than a
     slide. */
  #island-btn {
    transition:
      width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      height 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #site-header[data-island-open] #island-btn {
    width: 20rem;
    height: 4rem;
  }

  /* Expanding the island eats centre space, so the converge cap must know the
     wider width — otherwise the islands would slide into the open capsule.
     22rem, not 20rem: the spring overshoots past the final width, and the cap
     has to reserve room for the peak or the bounce would clip the left island. */
  #site-header[data-island-open] .header-shell {
    --island-w: 22rem;
  }

  /* One layer is always inert. `visibility` — not just opacity — keeps the
     hidden layer out of the button's accessible name, since a button's name is
     its text content; without it the collapsed pill would announce the expanded
     stats too. Listing visibility in the transition flips it at the end of the
     fade-out and the start of the fade-in. */
  .island-layer {
    transition:
      opacity 0.2s ease,
      visibility 0.2s;
  }

  /* Lead the detail layer in slightly behind the size change so it fades up
     into an already-mostly-grown capsule instead of being clipped mid-flight. */
  #site-header[data-island-open] .island-detail {
    transition-delay: 0.12s;
  }

  #site-header[data-island-open] .island-compact {
    opacity: 0;
    visibility: hidden;
  }

  #site-header:not([data-island-open]) .island-detail {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-shell {
      transition: opacity 0.3s ease;
    }

    #menu-backdrop,
    #menu-items {
      transition: none;
    }

    #island-btn,
    .island-layer,
    #site-header[data-island-open] .island-detail {
      transition: none;
    }

    #nav-indicator {
      transition: opacity 0.2s ease;
    }

    .nav-item .nav-icon,
    .nav-item:active .nav-icon {
      transition: none;
      transform: none;
    }

    /* The caret keeps its flipped state — it signals whether the submenu is
       open — but snaps instead of rotating. */
    .nav-caret {
      transition: none;
    }

    #nav-indicator.indicator-pop {
      animation: none;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // NOTE: the <header> uses transition:persist, so its DOM survives View
  // Transitions. Every setup() below must therefore be IDEMPOTENT (guarded
  // with a data-flag) — after-swap handlers re-run against the *same* nodes.
  // ---------------------------------------------------------------------------

  import { dayKeyIn, daysUntil } from "@/utils/siteAge";

  // Resolve a raw URL path (e.g. "/zh/posts/x/" or "/blog/en/posts/")
  // against the configured base + locale prefix → "" or "/posts/x".
  function resolveNavPath(header: HTMLElement, rawPath: string): string {
    const base = header.dataset.base || "/";
    const localePrefix = header.dataset.localePrefix || "";
    let path = rawPath;
    if (base && base !== "/" && path.startsWith(base)) {
      path = path.slice(base.length);
    }
    if (localePrefix && path.startsWith(localePrefix)) {
      path = path.slice(localePrefix.length);
    }
    return path.replace(/\/+$/, "");
  }

  // Refresh active-link highlighting from the current location.
  // Runs on load and after every astro:after-swap (the persisted header keeps
  // stale server-rendered state otherwise).
  function updateHeaderActive() {
    const header = document.getElementById("site-header");
    if (!header) return;

    const currentPath = resolveNavPath(header, window.location.pathname);
    const firstSegment = (p: string) => p.split("/").filter(Boolean)[0] ?? "";

    // data-nav-path may list several paths (comma-separated) for grouped
    // nav items, e.g. the Posts group covering /posts, /tags and /archives.
    const matchesNavPath = (el: HTMLElement) =>
      (el.dataset.navPath || "/")
        .split(",")
        .map(p => p.trim())
        .filter(Boolean)
        .some(navPathRaw => {
          const navPath = resolveNavPath(header, navPathRaw);
          return (
            currentPath === navPath ||
            firstSegment(currentPath) === firstSegment(navPath)
          );
        });

    header.querySelectorAll<HTMLElement>("[data-nav-path]").forEach(el => {
      const active = matchesNavPath(el);

      if (el.classList.contains("nav-item")) {
        if (active) el.setAttribute("data-active", "true");
        else el.removeAttribute("data-active");
      } else {
        el.classList.toggle("active-nav", active);
      }

      // Only real links get the current-page marking. The grouped item is a
      // <button> that merely *contains* the current page, so the matching
      // link inside its submenu carries it instead.
      if (active && el.tagName === "A") el.setAttribute("aria-current", "page");
      else el.removeAttribute("aria-current");
    });

    // Glide the indicator onto the (visible) active nav item.
    const nav = document.getElementById("site-nav");
    if (!nav) return;

    const items = [...nav.querySelectorAll<HTMLElement>(".nav-item")];
    if (items.length === 0) return;
    const visible = items.filter(item => item.offsetParent !== null);
    const pool = visible.length > 0 ? visible : items;
    const target =
      pool.find(item => item.getAttribute("data-active") === "true") ?? pool[0];
    if (target) moveIndicator(target);

    positionNavSubmenus();
  }

  // Glide the indicator pill onto a nav item and invert its text.
  function moveIndicator(item: HTMLElement) {
    const nav = document.getElementById("site-nav");
    const indicator = document.getElementById("nav-indicator");
    if (!nav || !indicator) return;

    const x = `${item.offsetLeft}px`;
    // Keep the custom property in sync so the pop keyframe can reuse it.
    indicator.style.setProperty("--indicator-x", x);
    indicator.style.width = `${item.offsetWidth}px`;
    indicator.style.transform = `translateX(${x})`;
    nav
      .querySelectorAll<HTMLElement>(".nav-item")
      .forEach(l => l.classList.toggle("nav-inverted", l === item));
  }

  // Centre each submenu under its group button. The button and the panel both
  // resolve against the nav <ul>, so offsetLeft/offsetWidth and the panel's
  // `left` already share a coordinate space. A closed panel is display:none and
  // reports width 0, so this only has an effect once it is open.
  function positionNavSubmenus() {
    document
      .querySelectorAll<HTMLElement>("[data-nav-group]")
      .forEach(group => {
        const button = group.querySelector<HTMLElement>(".nav-item");
        const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
        if (!button || !panel) return;
        const centre = button.offsetLeft + button.offsetWidth / 2;
        panel.style.left = `${centre - panel.offsetWidth / 2}px`;
      });
  }

  // The nav item for the page you are already on keeps its <a> markup and
  // click feedback, but must not navigate — clicking it would just reload the
  // same page. Blocked here rather than in CSS so the item stays fully
  // interactive apart from the navigation itself.
  function guardNavClicks() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.navGuard === "true") return;
    header.dataset.navGuard = "true";

    header.addEventListener("click", e => {
      const target = e.target as HTMLElement | null;
      const link = target?.closest<HTMLAnchorElement>("a[data-nav-path]");
      if (!link) return;

      const isCurrent =
        link.getAttribute("data-active") === "true" ||
        link.classList.contains("active-nav");
      if (!isCurrent) return;

      e.preventDefault();
      // No indicator bounce on mobile, so closing the tap-away menu is the
      // only acknowledgement that the tap registered.
      if (link.closest("#menu-items")) closeMenus();
    });
  }

  // --- Mobile drawer ---------------------------------------------------------

  function drawerEls() {
    return {
      header: document.getElementById("site-header"),
      panel: document.getElementById("menu-items"),
      backdrop: document.getElementById("menu-backdrop"),
      openBtn: document.querySelector<HTMLButtonElement>("#menu-btn"),
      closeBtn: document.querySelector<HTMLButtonElement>("#drawer-close-btn"),
      menuIcon: document.getElementById("menu-icon"),
      closeIcon: document.getElementById("close-icon"),
    };
  }

  // The attribute on the header is the single source of truth. Reading
  // aria-expanded instead would let the two drift apart.
  function isDrawerOpen() {
    return (
      document
        .getElementById("site-header")
        ?.hasAttribute("data-drawer-open") ?? false
    );
  }

  // Lock via the ROOT element, not just <body>. <html> carries
  // `overflow-y-scroll`, and per CSS overflow propagation body's overflow only
  // reaches the viewport while the root's is `visible` — so a body-only lock is
  // a silent no-op here. Clearing the inline styles hands the root back to its
  // own overflow-y-scroll class, with no layout shift on mobile.
  function setScrollLock(locked: boolean) {
    const value = locked ? "hidden" : "";
    document.documentElement.style.overflow = value;
    document.body.style.overflow = value;
  }

  function setDrawerOpen(open: boolean, restoreFocus = false) {
    const { header, panel, openBtn, closeBtn, menuIcon, closeIcon } =
      drawerEls();
    if (!header || !panel) return;

    const openLabel = openBtn?.dataset.labelOpen ?? "Open menu";
    const closeLabel = openBtn?.dataset.labelClose ?? "Close menu";

    openBtn?.setAttribute("aria-expanded", open ? "true" : "false");
    openBtn?.setAttribute("aria-label", open ? closeLabel : openLabel);

    if (open) header.setAttribute("data-drawer-open", "");
    else header.removeAttribute("data-drawer-open");

    // The pill can be scrolled off-screen (data-hidden) while the hamburger
    // still holds focus, so a keyboard open would otherwise reveal a drawer
    // with no visible header behind it.
    if (open) header.removeAttribute("data-hidden");

    setScrollLock(open);

    if (menuIcon) menuIcon.classList.toggle("hidden", open);
    if (closeIcon) closeIcon.classList.toggle("hidden", !open);

    if (open) {
      panel.scrollTop = 0;
      // Reveal the group if the current page is inside it — otherwise the page
      // you are on stays hidden behind a collapsed parent. Done on the user's
      // own action rather than in updateHeaderActive (which also runs on
      // resize and would fight a manual collapse).
      if (menuGroupHasActivePage()) toggleMenuGroup(true);
      // Move focus into the dialog, off the hamburger. The rAF is load-bearing,
      // not cosmetic: `visibility` interpolates as a discrete step where t = 0
      // still maps to the start value (`hidden`), so a focus() in this same
      // task is refused — the panel only becomes focusable once the transition
      // has ticked. Re-checked inside because a before-swap close can land in
      // between.
      requestAnimationFrame(() => {
        if (isDrawerOpen()) closeBtn?.focus();
      });
    } else {
      toggleMenuGroup(false);
      if (restoreFocus) openBtn?.focus();
    }
  }

  function toggleNav() {
    const { openBtn, closeBtn, backdrop, panel } = drawerEls();

    const groupBtn =
      document.querySelector<HTMLButtonElement>("#menu-group-btn");
    if (groupBtn && groupBtn.dataset.bound !== "true") {
      groupBtn.dataset.bound = "true";
      groupBtn.addEventListener("click", () =>
        toggleMenuGroup(groupBtn.getAttribute("aria-expanded") !== "true")
      );
    }

    if (!openBtn || !closeBtn || !backdrop || !panel) return;
    if (openBtn.dataset.bound === "true") return;
    openBtn.dataset.bound = "true";
    closeBtn.dataset.bound = "true";
    backdrop.dataset.bound = "true";

    openBtn.addEventListener("click", () =>
      setDrawerOpen(!isDrawerOpen(), true)
    );
    closeBtn.addEventListener("click", () => setDrawerOpen(false, true));
    backdrop.addEventListener("click", () => setDrawerOpen(false, true));
  }

  // Escape to dismiss, and a Tab trap: role="dialog" + aria-modal promise that
  // focus cannot reach the scrimmed page behind. Bound once on `document`
  // (module scripts re-run on navigation, hence the window flag).
  function setupDrawerKeyboard() {
    const w = window as unknown as { __drawerKeyBound?: boolean };
    if (w.__drawerKeyBound) return;
    w.__drawerKeyBound = true;

    document.addEventListener("keydown", e => {
      if (!isDrawerOpen()) return;
      const { panel } = drawerEls();
      if (!panel) return;

      if (e.key === "Escape") {
        e.preventDefault();
        setDrawerOpen(false, true);
        return;
      }
      if (e.key !== "Tab") return;

      // Filter by rendered box: the collapsed group's links are in the DOM but
      // invisible, and would otherwise become a phantom "last" element that
      // stops the wrap-around from ever firing.
      const focusables = [
        ...panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        ),
      ].filter(el => el.getClientRects().length > 0);
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && (active === first || !panel.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  // Growing past `sm` CSS-hides the drawer; without this the scroll lock would
  // stay set and the page would be unscrollable with no drawer in sight.
  function setupDrawerBreakpoint() {
    const w = window as unknown as { __drawerBreakpointBound?: boolean };
    if (w.__drawerBreakpointBound) return;
    w.__drawerBreakpointBound = true;

    window.matchMedia("(min-width: 640px)").addEventListener("change", e => {
      if (e.matches) closeMenus();
    });
  }

  // --- Dynamic island --------------------------------------------------------

  function islandEls() {
    return {
      slot: document.getElementById("island-slot"),
      button: document.getElementById("island-btn"),
      event: document.querySelector<HTMLElement>("[data-island-event]"),
      countdown: document.querySelector<HTMLElement>("[data-island-countdown]"),
    };
  }

  // The header attribute is the single source of truth — the CSS morph keys off
  // it, and aria-expanded is mirrored onto the button for assistive tech. Same
  // arrangement as the drawer's data-drawer-open.
  function isIslandOpen() {
    return (
      document
        .getElementById("site-header")
        ?.hasAttribute("data-island-open") ?? false
    );
  }

  function setIslandOpen(open: boolean, restoreFocus = false) {
    const header = document.getElementById("site-header");
    const button = document.getElementById("island-btn");
    if (!header || !button) return;

    if (open) header.setAttribute("data-island-open", "");
    else header.removeAttribute("data-island-open");
    button.setAttribute("aria-expanded", open ? "true" : "false");

    if (!open && restoreFocus) button.focus();
  }

  function closeIsland() {
    if (isIslandOpen()) setIslandOpen(false);
  }

  function setupIsland() {
    const { button } = islandEls();
    if (!button) return;

    if (button.dataset.bound !== "true") {
      button.dataset.bound = "true";
      button.addEventListener("click", () => setIslandOpen(!isIslandOpen()));
    }

    setupIslandDismiss();
    setupIslandBreakpoint();
  }

  // Escape and click-outside. Bound once on `document` (module scripts re-run on
  // navigation, hence the window flag — same as the drawer's keyboard setup).
  function setupIslandDismiss() {
    const w = window as unknown as { __islandDismissBound?: boolean };
    if (w.__islandDismissBound) return;
    w.__islandDismissBound = true;

    document.addEventListener("click", e => {
      if (!isIslandOpen()) return;
      const { slot } = islandEls();
      const target = e.target as Node | null;
      if (slot && target && slot.contains(target)) return;
      setIslandOpen(false);
    });

    document.addEventListener("keydown", e => {
      if (e.key !== "Escape" || !isIslandOpen()) return;
      e.preventDefault();
      setIslandOpen(false, true);
    });
  }

  // The island is xl-only. Shrinking past that breakpoint CSS-hides the slot,
  // which would strand a panel that is still logically open.
  function setupIslandBreakpoint() {
    const w = window as unknown as { __islandBreakpointBound?: boolean };
    if (w.__islandBreakpointBound) return;
    w.__islandBreakpointBound = true;

    window.matchMedia("(min-width: 1280px)").addEventListener("change", e => {
      if (!e.matches) closeIsland();
    });
  }

  // The clock is the visitor's local time. Everything day-scoped resolves
  // "today" in the SITE timezone instead, so the countdown agrees with the
  // server-rendered value and every visitor sees the same number.
  function startIslandClock() {
    const slot = document.getElementById("island-slot");
    if (!slot) return;

    const tz = slot.dataset.tz || undefined;
    const eventKey = slot.dataset.event || "";
    const locale = document.documentElement.lang || undefined;

    const clockFmt = new Intl.DateTimeFormat(locale, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    });

    const fill = (tpl: string, days: number) =>
      tpl.replace(/\{\{days\}\}/g, String(days));

    let lastDay = "";

    const tick = () => {
      const { event, countdown } = islandEls();
      const d = new Date();

      // Both layers carry their own clock, and only one is announced at a time.
      document
        .querySelectorAll<HTMLElement>("[data-island-clock]")
        .forEach(el => {
          el.textContent = clockFmt.format(d);
        });

      // Everything below depends on the calendar day, not the second. Skipping
      // when the key is unchanged also self-heals background-tab throttling:
      // after a throttled gap the next tick catches up.
      const day = dayKeyIn(tz, d);
      if (day === lastDay) return;
      lastDay = day;

      if (event && countdown && eventKey) {
        const days = daysUntil(eventKey, tz, d);
        const template = countdown.dataset.template ?? "";
        // No i18n key for "today" or "it has passed", so it steps aside.
        const show = days !== null && days > 0 && template !== "";
        if (show) countdown.textContent = fill(template, days);
        event.classList.toggle("hidden", !show);
        event.classList.toggle("flex", show);
      }
    };

    // On `window`, not a module-scoped variable: a re-run of the module (which
    // happens on navigation) would otherwise leak the previous interval.
    const w = window as unknown as { __islandTimer?: number };
    window.clearInterval(w.__islandTimer);
    tick();
    w.__islandTimer = window.setInterval(tick, 1000);
  }

  function menuGroupHasActivePage() {
    return !!document.querySelector(
      "#menu-group-items [data-nav-path].active-nav"
    );
  }

  function toggleMenuGroup(open: boolean) {
    const groupBtn =
      document.querySelector<HTMLButtonElement>("#menu-group-btn");
    const groupItems = document.querySelector("#menu-group-items");
    if (!groupBtn || !groupItems) return;

    groupBtn.setAttribute("aria-expanded", open ? "true" : "false");
    groupItems.classList.toggle("hidden", !open);
    groupItems.classList.toggle("flex", open);
    groupItems.classList.toggle("animate-menu-in", open);
  }

  // Close the mobile drawer (e.g. after navigating with it open). The group
  // collapses with it, so reopening always starts from a known state.
  // Never restores focus: this runs during navigation, where focusing the
  // hamburger would steal focus from the incoming page.
  function closeMenus() {
    setDrawerOpen(false, false);
    toggleMenuGroup(false);
    // Self-healing, so no path can strand the page with a locked scroll.
    setScrollLock(false);
  }

  // How long the submenu lingers after the pointer leaves the group, so it can
  // be crossed from the button down to the panel without snapping shut.
  const GROUP_CLOSE_DELAY = 150;

  // Grouped nav item: hover, click, Escape and focus handling for its submenu.
  // Bound inside setupNavIndicator's nav-level guard, since the header persists.
  function setupNavGroups(nav: HTMLElement) {
    nav.querySelectorAll<HTMLElement>("[data-nav-group]").forEach(group => {
      if (group.dataset.bound === "true") return;
      group.dataset.bound = "true";

      const button = group.querySelector<HTMLButtonElement>(".nav-item");
      const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
      if (!button || !panel) return;

      let closeTimer = 0;
      // A pointer that has hovered the group open is already looking at the
      // panel, so its click must not toggle that away — it would mean every
      // mouse click closed what the hover had just revealed.
      let openedByHover = false;

      const isOpen = () => button.getAttribute("aria-expanded") === "true";

      const open = (byHover = false) => {
        window.clearTimeout(closeTimer);
        if (isOpen()) return;
        openedByHover = byHover;
        button.setAttribute("aria-expanded", "true");
        panel.classList.remove("hidden");
        panel.classList.add("flex", "animate-menu-in");
        moveIndicator(button);
        positionNavSubmenus();
      };

      const close = () => {
        window.clearTimeout(closeTimer);
        if (!isOpen()) return;
        openedByHover = false;
        button.setAttribute("aria-expanded", "false");
        panel.classList.add("hidden");
        panel.classList.remove("flex", "animate-menu-in");
        updateHeaderActive();
      };

      const closeSoon = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(close, GROUP_CLOSE_DELAY);
      };

      // Only a real mouse hovers. Touch pointers would otherwise open the panel
      // on tap and then close it again when pointerleave fires as the finger
      // lifts — they toggle through the click handler instead.
      group.addEventListener("pointerenter", e => {
        if (e.pointerType === "mouse") open(true);
      });
      group.addEventListener("pointerleave", e => {
        if (e.pointerType === "mouse") closeSoon();
      });

      button.addEventListener("click", () => {
        if (openedByHover) return;
        if (isOpen()) close();
        else open();
      });

      group.addEventListener("keydown", e => {
        if (e.key !== "Escape" || !isOpen()) return;
        close();
        button.focus();
      });

      // Tabbing into the panel keeps the group open; leaving it closes. The
      // read is deferred because focusout fires before focus lands.
      group.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (!group.contains(document.activeElement)) close();
        });
      });

      // Any panel click closes the group: a link that navigates is finished
      // with it, and a link to the current page (whose navigation
      // guardNavClicks blocks) at least gets the collapse as feedback.
      panel.addEventListener("click", close);
    });
  }

  // Collapse the desktop submenus. Wired to clicks outside the nav and to
  // view-transition swaps, which would otherwise leave an open panel on screen
  // because the header node is persisted.
  function closeNavGroups() {
    document
      .querySelectorAll<HTMLElement>("[data-nav-group]")
      .forEach(group => {
        const button = group.querySelector<HTMLElement>(".nav-item");
        const panel = group.querySelector<HTMLElement>("[data-nav-submenu]");
        if (!button || !panel) return;
        button.setAttribute("aria-expanded", "false");
        panel.classList.add("hidden");
        panel.classList.remove("flex", "animate-menu-in");
      });
  }

  // Clicking anywhere outside a group closes it. Bound to the persisted header
  // rather than `document`, which would re-register a listener on every swap.
  function setupHeaderDismiss() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.dismissBound === "true") return;
    header.dataset.dismissBound = "true";

    header.addEventListener("click", e => {
      const target = e.target as HTMLElement | null;
      if (target?.closest("[data-nav-group]")) return;
      closeNavGroups();
    });
  }

  // Sliding nav indicator: a dark pill that glides onto the active item when
  // the page (or the open submenu) changes. Pointer hover deliberately does
  // not move it.
  function setupNavIndicator() {
    const nav = document.getElementById("site-nav");
    const indicator = document.getElementById("nav-indicator");
    if (!nav || !indicator) return;

    if (nav.dataset.bound !== "true") {
      nav.dataset.bound = "true";

      nav.querySelectorAll<HTMLElement>(".nav-item").forEach(item => {
        // Click pop: replay the indicator bounce animation.
        item.addEventListener("click", () => {
          indicator.classList.remove("indicator-pop");
          void indicator.offsetWidth; // restart the animation
          indicator.classList.add("indicator-pop");
        });
      });
      indicator.addEventListener("animationend", () => {
        indicator.classList.remove("indicator-pop");
      });

      setupNavGroups(nav);
    }

    // Initial placement, re-measure once fonts settle.
    updateHeaderActive();
    indicator.style.opacity = "1";
    document.fonts?.ready.then(() => updateHeaderActive());
    window.addEventListener("resize", () => updateHeaderActive());
  }

  // Floating header scroll behaviour:
  //  1. scrolled a little  → islands converge towards the nav (data-scrolled)
  //  2. scrolled far + still going down → slide up and hide (data-hidden)
  //  3. any upward scroll  → reappear
  function handleHeaderScroll() {
    const header = document.getElementById("site-header");
    if (!header) return;

    let lastY = window.scrollY;

    const onScroll = () => {
      const current = document.getElementById("site-header");
      if (!current) return;
      const y = window.scrollY;

      // The island deliberately stays put and keeps its state while scrolling;
      // the CSS converge cap is what keeps it clear of the side islands.
      if (y > 24) current.setAttribute("data-scrolled", "");
      else current.removeAttribute("data-scrolled");

      const delta = y - lastY;
      if (y > 260 && delta > 4) {
        current.setAttribute("data-hidden", "");
      } else if (delta < -4 || y <= 260) {
        current.removeAttribute("data-hidden");
      }
      lastY = y;
    };

    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    if (skipLink.dataset.bound === "true") return;
    skipLink.dataset.bound = "true";

    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // The header uses transition:persist, so its DOM node is kept alive but
  // RE-INSERTED on every navigation — which restarts CSS animations (the
  // entrance slide-in would replay on each route change, looking like the
  // header "reloads"). Mark the node once the entrance has played; the
  // attribute travels with the persisted node across swaps, and the CSS
  // rule above then suppresses the entrance animation for good.
  function markHeaderEntered() {
    const header = document.getElementById("site-header");
    if (!header) return;
    header.dataset.entered = "true";
    // Clear a half-finished click-pop so re-insertion cannot restart it.
    document.getElementById("nav-indicator")?.classList.remove("indicator-pop");
  }
  document.addEventListener("astro:after-swap", markHeaderEntered);
  // Initial page load: let the entrance animation finish once, then mark.
  window.addEventListener("load", () => setTimeout(markHeaderEntered, 600));

  guardNavClicks();
  setupHeaderDismiss();

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  setupDrawerKeyboard();
  setupDrawerBreakpoint();

  setupIsland();
  document.addEventListener("astro:after-swap", setupIsland);

  startIslandClock();
  document.addEventListener("astro:after-swap", startIslandClock);

  // Reset before the swap so an open panel is not snapshotted — and so its
  // animate-menu-in is gone before the header node is re-inserted, which would
  // otherwise replay the entrance animation.
  if (
    !(window as unknown as { __islandSwapBound?: boolean }).__islandSwapBound
  ) {
    (window as unknown as { __islandSwapBound?: boolean }).__islandSwapBound =
      true;
    document.addEventListener("astro:before-swap", closeIsland);
  }

  setupNavIndicator();
  document.addEventListener("astro:after-swap", setupNavIndicator);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);

  // The persisted header keeps stale active state across navigations —
  // refresh it (and close menus) after each swap. Without closing the groups
  // here, an open submenu would ride along to the next page.
  document.addEventListener("astro:after-swap", () => {
    closeNavGroups();
    updateHeaderActive();
    closeMenus();
  });

  // Close before the swap too: otherwise the View Transition snapshots the
  // outgoing page with the drawer open and the incoming page paints one frame
  // of it. (The lightbox does the same for its overlay.)
  if (
    !(window as unknown as { __drawerSwapBound?: boolean }).__drawerSwapBound
  ) {
    (window as unknown as { __drawerSwapBound?: boolean }).__drawerSwapBound =
      true;
    document.addEventListener("astro:before-swap", closeMenus);
  }

  // Bound once on `document` (persists across view transitions); the handler
  // looks up the current header element on every event.
  if (
    !(window as unknown as { __headerScrollBound?: boolean })
      .__headerScrollBound
  ) {
    (
      window as unknown as { __headerScrollBound?: boolean }
    ).__headerScrollBound = true;
    handleHeaderScroll();
  }
</script>
