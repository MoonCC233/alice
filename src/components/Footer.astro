---
import type { HTMLAttributes } from "astro/types";
import { getCollection } from "astro:content";
import Socials from "./Socials.astro";
import { getAssetPath } from "@/utils/withBase";
import { daysSince } from "@/utils/siteAge";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;

// 主题信息：名称 / 作者 / 相关链接
const THEME = {
  name: "Alice",
  author: "TeAnli",
  authorUrl: "https://github.com/TeAnli",
  repoUrl: "https://github.com/TeAnli/astro-theme-alice",
};

const { site, hero } = config;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? site.lang;

const now = new Date();
const currentYear = now.getFullYear();

// 站点统计：已发布文章数、标签数
const posts = await getCollection("posts");
const published = posts.filter(post => !post.data.draft);
const postCount = published.length;
const tagCount = new Set(published.flatMap(post => post.data.tags ?? [])).size;

// 建站天数。按站点时区算，与 Hero 和顶栏灵动岛保持一致
const runningDays = hero?.since ? daysSince(hero.since, site.timezone) : null;

// 服务端先渲染一份初始时间，客户端脚本会实时更新
const datetimeFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
const initialDatetime = datetimeFormatter.format(now);
---

<footer class:list={["app-layout", className]} {...attrs}>
  <div class="border-border border-t pt-8 pb-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr] lg:gap-6">
      {/* 品牌栏：站点名 + 简介 + 社交链接 */}
      <div class="space-y-3 text-center sm:text-left">
        <p class="text-foreground font-semibold tracking-wide">{site.title}</p>
        <p class="text-muted-foreground line-clamp-3 text-sm leading-relaxed">
          {site.description}
        </p>
        <div class="flex justify-center sm:justify-start">
          <Socials />
        </div>
      </div>

      {/* 站点信息 */}
      <div class="text-center sm:text-left">
        <p
          class="text-muted-foreground mb-3 text-xs font-semibold tracking-widest uppercase"
        >
          {t.footer.siteInfo}
        </p>
        <ul class="text-muted-foreground space-y-2 text-sm">
          <li>{tplStr(t.footer.postCount, { count: postCount })}</li>
          <li>{tplStr(t.footer.tagCount, { count: tagCount })}</li>
          {
            runningDays !== null && (
              <li>{tplStr(t.footer.runningDays, { days: runningDays })}</li>
            )
          }
          <li>
            <a
              href={getAssetPath("rss.xml")}
              class="hover:text-accent inline-flex items-center gap-1 transition-colors"
            >
              RSS
              <span
                class="bg-accent/15 text-accent rounded px-1 py-px text-[10px] font-semibold uppercase"
              >
                XML
              </span>
              <span class="sr-only">{t.a11y.rssFeed}</span>
            </a>
          </li>
          <li class="flex items-center justify-center gap-2 sm:justify-start">
            <span>{t.footer.localTime}</span>
            <time
              id="footer-datetime"
              class="text-foreground tabular-nums"
              datetime={now.toISOString()}
            >
              {initialDatetime}
            </time>
          </li>
        </ul>
      </div>
    </div>

    {/* 底栏：版权 + 主题署名 */}
    <div
      class="border-border text-muted-foreground mt-8 flex flex-col items-center justify-between gap-2 border-t border-dashed pt-4 text-xs sm:flex-row"
    >
      <p
        class="flex flex-wrap items-center justify-center gap-x-1 whitespace-nowrap"
      >
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        {
          site.profile ? (
            <a
              href={site.profile}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground font-medium transition-colors"
            >
              {site.author}
            </a>
          ) : (
            <span class="font-medium">{site.author}</span>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <span>{t.footer.allRightsReserved}</span>
      </p>
      <p class="flex items-center gap-1 whitespace-nowrap">
        <a
          href={THEME.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors"
        >
          {tplStr(t.footer.poweredBy, { theme: THEME.name })}
        </a>
        <span aria-hidden="true">&middot;</span>
        <a
          href={THEME.authorUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors"
        >
          {THEME.author}
        </a>
      </p>
    </div>
  </div>
</footer>

<script>
  // 页脚实时时钟：每秒更新一次，并兼容 View Transitions 页面切换
  const fmt = new Intl.DateTimeFormat(
    document.documentElement.lang || undefined,
    {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }
  );

  let timer: ReturnType<typeof setInterval> | undefined;

  function updateDatetime() {
    const el = document.getElementById("footer-datetime");
    if (el) el.textContent = fmt.format(new Date());
  }

  function startClock() {
    updateDatetime();
    clearInterval(timer);
    timer = setInterval(updateDatetime, 1000);
  }

  startClock();
  // 页面切换后重新绑定（ClientRouter 会替换 DOM，元素引用会失效）
  document.addEventListener("astro:page-load", startClock);
</script>
