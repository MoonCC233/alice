---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-10 sm:pb-16", className]}
>
  <h1 class="max-w-3xl text-3xl font-semibold tracking-[-0.04em] sm:text-5xl">
    {pageTitle}
    <slot name="title" />
  </h1>
  <p
    class="text-muted-foreground mt-4 mb-10 max-w-2xl text-base leading-relaxed"
  >
    {pageDesc}
  </p>
  <slot />
</main>

<script>
  // Keep the "back" target fresh. Bound immediately (module scripts run after
  // the DOM is parsed) as well as after each View Transition: binding only on
  // `astro:page-load` raced the router and could miss the initial load.
  function saveBackUrl() {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  }

  saveBackUrl();
  document.addEventListener("astro:after-swap", saveBackUrl);
</script>
