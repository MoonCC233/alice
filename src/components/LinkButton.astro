---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled, class: className, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
---

<Button
  aria-disabled={disabled}
  class:list={[
    "group border-foreground/30 inline-flex items-center gap-2 border-b pb-1 font-medium transition-[border-color,color,transform] duration-200",
    { "hover:border-foreground hover:-translate-y-0.5": !disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
