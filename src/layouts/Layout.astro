---
import { ClientRouter } from "astro:transitions";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalURL?: string;
  /** Renders the breadcrumb trail under the header (inner pages only). */
  breadcrumb?: boolean;
  /** Keeps the global footer optional for immersive reading layouts. */
  showFooter?: boolean;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  breadcrumb = false,
  showFooter = true,
} = Astro.props;

// rss.xml is a fixed file route, not a directory route — the locale helper
// would append a trailing slash here and the browser would request
// /rss.xml/, which 404s.
const rssHref = getAssetPath("rss.xml");
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" href={getAssetPath("favicon.ico")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <!-- Decide before first paint so a returning visitor never sees a flash of
         the intro that should be skipped. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        let shouldPlay = !reducedMotion;

        try {
          shouldPlay =
            shouldPlay && sessionStorage.getItem("alice-splash-seen") !== "1";
        } catch {
          // Play once per load when session storage is unavailable.
        }

        root.setAttribute("data-splash", shouldPlay ? "play" : "skip");
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <div id="splash" aria-hidden="true" data-phase="idle">
      <div class="splash-wipe" aria-hidden="true"></div>
      <div class="splash-content">
        <span class="splash-eyebrow">PERSONAL KNOWLEDGE BASE</span>
        <strong class="splash-title">{site.title}</strong>
        <span class="splash-subtitle">
          {config.hero.role || site.description}
        </span>
      </div>
      <div class="splash-rule" aria-hidden="true">
        <span></span>
      </div>
    </div>

    <Header />

    {breadcrumb && <Breadcrumb />}

    <!-- Grows to fill the viewport so the footer sits at the bottom on short
         pages; pagination's own mt-auto then lands directly above it. -->
    <div class="flex flex-1 flex-col">
      <slot />
    </div>

    {showFooter && <Footer />}

    <script is:inline>
      (function () {
        const splash = document.getElementById("splash");
        const root = document.documentElement;
        if (!splash || root.dataset.splash !== "play") return;

        const finish = () => {
          splash.dataset.phase = "exit";
          window.setTimeout(() => {
            root.setAttribute("data-splash", "skip");
            splash.remove();
            try {
              sessionStorage.setItem("alice-splash-seen", "1");
            } catch {
              // The animation still completes when session storage is blocked.
            }
          }, 760);
        };

        window.requestAnimationFrame(() => {
          splash.dataset.phase = "wipe";
          window.setTimeout(() => {
            splash.dataset.phase = "solid";
          }, 760);
          window.setTimeout(finish, 1700);
        });
      })();
    </script>

    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
